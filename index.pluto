print "Creating ExportDojoRecipes..."
do
	local ExportDojoRecipes = {
		__order = { "research", "fabrications", "rooms", "decos", "colours", "backdrops" },
		research = { __order = {} },
		fabrications = { __order = {} },
		rooms = { __order = {} },
		decos = { __order = {} },
		colours = { __order = {} },
		backdrops = { __order = {} },
	}
	local DojoRecipeManifest = io.contents("extras/datafiles/Extracted/Debug/Lotus/Types/Game/Store/DojoRecipeManifest.json") |> json.decode|json.withorder|
	for DojoRecipeManifest.RecipeItems as uniqueName do
		if obj_find_property(uniqueName, "IsResearch") == 1 then
			ExportDojoRecipes.research.__order:insert(uniqueName)
			ExportDojoRecipes.research[uniqueName] = {
				__order = { "price", "time", "skipTimePrice", "replicatePrice", "guildXpValue", "ingredients" },
				price = obj_find_property(uniqueName, "ResearchRegularPrice"),
				time = obj_find_property(uniqueName, "ResearchTime"),
				skipTimePrice = obj_find_property(uniqueName, "SkipResearchTimePrice"),
				replicatePrice = obj_find_property(uniqueName, "ReplicateTechPrice"),
				guildXpValue = obj_find_property(uniqueName, "GuildXpValue"),
				ingredients = obj_find_property(uniqueName, "ResearchIngredients"),
			}
			for ExportDojoRecipes.research[uniqueName].ingredients as ingredient do
				ingredient.ItemType = obj_resolve_path(uniqueName, ingredient.ItemType)
			end
			if TechPrereq := obj_find_property(uniqueName, "TechPrereq") then
				ExportDojoRecipes.research[uniqueName].__order:insert("techPrereq")
				ExportDojoRecipes.research[uniqueName].techPrereq = obj_resolve_path(uniqueName, TechPrereq)
			end
			if obj_find_property(uniqueName, "IsPersonalResearch") == 1 then
				if Ingredients := obj_find_property(uniqueName, "Ingredients") then
					ExportDojoRecipes.fabrications.__order:insert(uniqueName)
					ExportDojoRecipes.fabrications[uniqueName] = {
						__order = { "resultType", "price", "ingredients" },
						resultType = from_storeitem(obj_find_property(uniqueName, "ResultItem")),
						price = obj_find_property(uniqueName, "BuildPrice"),
						ingredients = Ingredients,
					}
				else
					ExportDojoRecipes.research[uniqueName].__order:insert(1, "resultType")
					ExportDojoRecipes.research[uniqueName].resultType = from_storeitem(obj_find_property(uniqueName, "ResultItem"))
				end
			end
			if uniqueName:sub(1, 39) == "/Lotus/Types/Items/Research/DojoColors/" then
				local name = obj_find_property(uniqueName, "LocalizeTag")

				ExportDojoRecipes.colours.__order:insert(uniqueName)
				ExportDojoRecipes.colours[uniqueName] = {
					__order = { "name", "colour" },
					name = name,
					colour = format_colour_arr(obj_find_property(uniqueName, "Color")),
				}

				import_from_languages_bin(name)
			elseif uniqueName:sub(1, 41) == "/Lotus/Types/Items/Research/DojoSkyboxes/" then
				local name = obj_find_property(uniqueName, "LocalizeTag")

				ExportDojoRecipes.backdrops.__order:insert(uniqueName)
				ExportDojoRecipes.backdrops[uniqueName] = {
					__order = { "name", "icon" },
					name = name,
					icon = obj_find_property(uniqueName, "Icon"),
				}

				import_from_languages_bin(name)
			end
		elseif ResultPrefab := obj_find_property(uniqueName, "ResultPrefab") then
			local name = obj_find_property(uniqueName, "LocalizeTag")
			local description = obj_find_property(uniqueName, "LocalizeDescTag")

			ExportDojoRecipes.rooms.__order:insert(uniqueName)
			ExportDojoRecipes.rooms[uniqueName] = {
				__order = { "resultType", "name", "description", "icon", "price", "time", "skipTimePrice", "ingredients", "guildXpValue", "destructionTime", "capacity", "energy", "decoCapacity", "hidden" },
				resultType = ResultPrefab,
				name = name,
				description = description,
				icon = obj_find_property(uniqueName, "Icon") or error(uniqueName),
				price = obj_find_property(uniqueName, "BuildPrice"),
				time = obj_find_property(uniqueName, "BuildTime"),
				skipTimePrice = obj_find_property(uniqueName, "SkipBuildTimePrice"),
				ingredients = obj_find_property(uniqueName, "Ingredients"),
				guildXpValue = obj_find_property(uniqueName, "GuildXpValue"),
				destructionTime = obj_find_property(uniqueName, "DestructionTime"),
				capacity = obj_find_property(uniqueName, "Capacity") or 0,
				energy = obj_find_property(uniqueName, "Energy"),
				decoCapacity = obj_find_property(uniqueName, "DecoCapacity") or 200,
				hidden = obj_find_property(uniqueName, "ShowInUI") == 0 ? true : nil
			}

			import_from_languages_bin(name)
			import_from_languages_bin(description)
		end

		-- NpcPlaceables are research + decos
		if ResultDecoration := obj_find_property(uniqueName, "ResultDecoration") then
			local name = obj_find_property(uniqueName, "LocalizeTag")
			local description = obj_find_property(uniqueName, "LocalizeDescTag")

			ExportDojoRecipes.decos.__order:insert(uniqueName)
			ExportDojoRecipes.decos[uniqueName] = {
				__order = { "resultType", "name", "description", "icon", "price", "time", "skipTimePrice", "ingredients", "guildXpValue", "capacityCost", "requiredInVault" },
				resultType = ResultDecoration,
				name = name,
				description = description,
				icon = obj_find_property(uniqueName, "Icon") or error(uniqueName),
				price = obj_find_property(uniqueName, "BuildPrice"),
				time = obj_find_property(uniqueName, "BuildTime"),
				skipTimePrice = obj_find_property(uniqueName, "SkipBuildTimePrice"),
				ingredients = obj_find_property(uniqueName, "Ingredients") or {},
				guildXpValue = obj_find_property(uniqueName, "GuildXpValue"),
				capacityCost = obj_find_property(uniqueName, "DecoCapacityCost"),
				requiredInVault = obj_find_property(uniqueName, "RequiredInVault") == 1 ? true : nil,
			}

			import_from_languages_bin(name)
			import_from_languages_bin(description)
		else
			-- /Lotus/Levels/ClanDojo/ComponentPropRecipes/DuviriPlaceables/DuviriPlaceables2ndRelease/DUVxChairC is in the manifest but doesn't exist
		end
	end
	write_data_file("ExportDojoRecipes.json", ExportDojoRecipes)
end

