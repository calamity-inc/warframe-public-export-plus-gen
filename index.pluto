-- Before running this script, ensure datafiles & materials in extras have been extracted, and verify the following checkout directories:
$define PE_BASE = "../warframe-public-export" -- https://github.com/calamity-inc/warframe-public-export
$define OUTPUT_BASE = "../warframe-public-export-plus/"
$define LANGUAGES_BASE = "../warframe-languages-bin-data/" -- https://github.com/calamity-inc/warframe-languages-bin-data
$define PACKAGES_BIN_BASE = [[F:\warframe-packages-bin-data]] -- https://github.com/Sainan/warframe-packages-bin-data

$define MSGPACK = false

local { cat, json, xml } = require "*"

--[[local function obj_exists(path)
	return io.isfile(PACKAGES_BIN_BASE .. path .. ".json")
end]]

local obj_cache = {}
local function obj_from_path(path)
	if not obj_cache[path] then
		if data := io.contents(PACKAGES_BIN_BASE .. path .. ".json") then
			obj_cache[path] = data |> json.decode|json.withorder|
		else
			obj_cache[path] = {}
		end
	end
	return obj_cache[path]
end
local function validate_path(path)
	assert(obj_cache[path] or io.exists(PACKAGES_BIN_BASE .. path .. ".json"), path)
end

local function path_get_parent(path)
	local parts = path:split("/")
	assert(#parts ~= 0, "invalid call to path_get_parent")
	parts:remove()
	assert(#parts ~= 0, "can't get parent of root")
	return parts:concat("/")
end

local function obj_resolve_path(path, rel)
	if #rel == 0 then
		return nil
	end
	if rel[1] == '/' then
		return rel
	end
	local base = path
	repeat
		base = path_get_parent(base)
		if #base == 0 then
			return nil
		end
	until io.exists(PACKAGES_BIN_BASE .. base .. "/" .. rel .. ".json")
	return base .. "/" .. rel
end

local obj_has_parent
obj_has_parent = function(path, target_parent)
	local obj = obj_from_path(path)
	if obj.parent then
		local parentPath = obj_resolve_path(path, obj.parent)
		if parentPath == target_parent then
			return true
		end
		return obj_has_parent(parentPath, target_parent)
	end
	return false
end

local obj_find_property
obj_find_property = function(path, target_property)
	local obj = obj_from_path(path)
	assert(obj, "invalid call to obj_find_property")
	if obj?.data?[target_property] then
		return obj.data[target_property], path
	end
	if obj.parent then
		return obj_find_property(obj_resolve_path(path, obj.parent), target_property)
	end
end

local obj_find_property_2
obj_find_property_2 = function(path, target_property_1, target_property_2)
	local obj = obj_from_path(path)
	assert(obj, "invalid call to obj_has_parent")
	if obj?.data?[target_property_1]?[target_property_2] then
		return obj.data[target_property_1][target_property_2], path
	end
	if obj.parent then
		return obj_find_property_2(obj_resolve_path(path, obj.parent), target_property_1, target_property_2)
	end
end

local obj_find_property_3
obj_find_property_3 = function(path, target_property_1, target_property_2, target_property_3)
	local obj = obj_from_path(path)
	assert(obj, "invalid call to obj_has_parent")
	if obj?.data?[target_property_1]?[target_property_2]?[target_property_3] then
		return obj.data[target_property_1][target_property_2]?[target_property_3], path
	end
	if obj.parent then
		return obj_find_property_3(obj_resolve_path(path, obj.parent), target_property_1, target_property_2, target_property_3)
	end
end

local function obj_find_base(path)
	local obj = obj_from_path(path)
	assert(obj, "invalid call to obj_find_base")
	while obj.parent do
		path = obj_resolve_path(path, obj.parent)
		obj = obj_from_path(path)
	end
	return path
end

local LANGS = { "en", "de", "es", "fr", "it", "ja", "ko", "pl", "pt", "ru", "tc", "th", "tr", "uk", "zh" }
local EXTRA_LANGS = { "de", "es", "fr", "it", "ja", "ko", "pl", "pt", "ru", "tc", "th", "tr", "uk", "zh" }

local tag_order = {}

local dicts = {
	en = { __order = tag_order },
	de = { __order = tag_order },
	es = { __order = tag_order },
	fr = { __order = tag_order },
	it = { __order = tag_order },
	ja = { __order = tag_order },
	ko = { __order = tag_order },
	pl = { __order = tag_order },
	pt = { __order = tag_order },
	ru = { __order = tag_order },
	tc = { __order = tag_order },
	th = { __order = tag_order },
	tr = { __order = tag_order },
	uk = { __order = tag_order },
	zh = { __order = tag_order },
}

local function store_tag(lang, item, field, tag)
	if tag == nil or tag == "" then
		print(field.." is nil or empty in "..dumpvar(item))
	end
	--[[if tag == "/Lotus/Language/Relics/VoidProjectionName" then
		return -- Avoid Public Export corrupting our dicts
	end]]
	local duplicate = dicts[lang][tag] ~= nil
	if item[field] ~= tag then
		dicts[lang][tag] = item[field]
	else
		duplicate = true
	end
	if lang == "en" then
		if not duplicate then
			tag_order:insert(tag)
		end
		item[field] = tag
	end
end

--[[local function set_tag(lang, tag, value)
	if lang == "en" and not dicts[lang][tag] then
		tag_order:insert(tag)
	end
	dicts[lang][tag] = value
end]]

local function fusion_level_to_rank(qa): int
	return switch qa do
		case "QA_VERY_HIGH" -> 10
		case "QA_HIGH" -> 5
		case "QA_MEDIUM" -> 3
		default -> 0
	end
end

