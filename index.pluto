for { "Amar", "Boreal", "Nira" } as archon do
	local deck_name = $"/Lotus/Types/Game/MissionDecks/NarmerSortie{archon}CrystalRewards"
	if not ExportRewards[deck_name] then
		validate_path(deck_name)
		ExportRewards.__order:insert(deck_name)
	end
	ExportRewards[deck_name] = {
		{
			{
				__order = { "type", "itemCount", "rarity" },
				type = "/Lotus/StoreItems/Types/Gameplay/NarmerSorties/ArchonCrystal"..archon,
				itemCount = 1,
				rarity = "COMMON"
			},
			{
				__order = { "type", "itemCount", "rarity" },
				type = "/Lotus/StoreItems/Types/Gameplay/NarmerSorties/ArchonCrystal"..archon.."Mythic",
				itemCount = 1,
				rarity = "UNCOMMON"
			}
		}
	}
end
local function computerify_drop_from_wiki(reward)
	local type = reward[1]
	local itemCount = reward[4] or 1
	if type == "Endo" then
		type, itemCount = bundle_fusion_points(itemCount)
	else
		if type == "Credits" then
			type = tostring(itemCount):reverse():gsub("(%d%d%d)", "%1,"):reverse():lstrip(",").." Credits"
			itemCount = 1
		elseif type == "Credits Cache" then
			if itemCount == 15000 then
				type = "5,000 Credits Cache"
				itemCount //= 5000
			elseif itemCount == 20000 or itemCount == 30000 or itemCount == 50000 then
				type = "10,000 Credits Cache"
				itemCount //= 10000
				-- There is a 50,000 cache, but they also use "5X 10,000 Credits Cache"
			else
				type = tostring(itemCount):reverse():gsub("(%d%d%d)", "%1,"):reverse():lstrip(",").." Credits Cache"
				itemCount = 1
			end
		elseif type == "Höllars Cache" then
			type = tostring(itemCount):reverse():gsub("(%d%d%d)", "%1,"):reverse():lstrip(",").." Höllars Cache"
			itemCount = 1
		end
		type = type:replace("3 Day ", "")
		if entry := name_to_storeitem_map[type:lower()] then
			type = entry
		else
			print("WARNING: Item type not resolved: "..type.." (itemCount="..itemCount..")")
			type = "/Lotus/StoreItems/RESOLUTION_FAILURE/"..itemCount.."x "..type
		end
	end
	return {
		__order = { "type", "itemCount", "probability" },
		type = type,
		itemCount = itemCount,
		probability = reward[3] / 100
	}
end
for DropTables.Missions as mission do
	if not mission.InternalName then
		continue
	end
	if type(mission.InternalName) == "string" then
		if mission.InternalName == "" then
			continue
		end
		mission.InternalName = { mission.InternalName }
	end
	if mission.InternalName.A then
		for rotation, deck_name in mission.InternalName do
			if not ExportRewards[deck_name] then
				validate_path(deck_name)
				ExportRewards.__order:insert(deck_name)
				ExportRewards[deck_name] = { {} }
				for mission.Rewards[rotation] as reward do
					ExportRewards[deck_name][1]:insert(computerify_drop_from_wiki(reward))
				end
			end
		end
	else
		local deck = {}
		for tier, rotation in { "A", "B", "C" } do
			if rewards := mission.Rewards[rotation] then
				deck[tier] = {}
				for rewards as reward do
					deck[tier]:insert(computerify_drop_from_wiki(reward))
				end
			end
		end
		for mission.InternalName as InternalName do
			if not ExportRewards[InternalName] then
				if InternalName ~= "/Lotus/Types/Game/MissionDecks/EventMissionRewards/ScarletSpearRailjackRewards" and InternalName ~= "/Lotus/Types/Game/MissionDecks/EventMissionRewards/ScarletSpearCondrixRewards" then
					validate_path(InternalName)
				end
				ExportRewards.__order:insert(InternalName)
				ExportRewards[InternalName] = deck
			end
		end
	end
end
