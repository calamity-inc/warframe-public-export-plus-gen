local function export_email(path, raw)
	local email = {
		__order = { "sender", "title", "body", "attachments", "countedAttachments" },
		sender = raw.sndr,
		title = raw.sub,
		body = raw.msg,
		attachments = {},
		countedAttachments = raw.countedAtt or {},
	}
	if raw.att then
		for raw.att as item do
			email.attachments:insert(obj_resolve_path(path, item))
		end
	end
	if raw.icon ~= "" then
		email.__order:insert("icon")
		email.icon = raw.icon
	end
	if raw.transmission ~= "" then
		email.__order:insert("transmission")
		email.transmission = raw.transmission
	end
	if raw.highPriority == 1 then
		email.__order:insert("highPriority")
		email.highPriority = true
	end
	if raw.customData and raw.customData ~= "" then
		email.__order:insert("customData")
		email.customData = raw.customData
	end
	if raw.cinematic and raw.cinematic ~= "" then
		email.__order:insert("cinematic")
		email.cinematic = raw.cinematic
	end

	if languages_bin_dicts.en[raw.sndr] then
		import_from_languages_bin(raw.sndr)
	end
	import_from_languages_bin(raw.sub)
	if languages_bin_dicts.en[raw.msg] then
		import_from_languages_bin(raw.msg)
	end
	return email
end

local function export_excludedPlatforms(path)
	local excludedPlatforms = {}
	if obj_find_property(path, "AvailableOnPlatform[CP_WINDOWS]") == 0 then excludedPlatforms:insert("CP_WINDOWS") end
	if obj_find_property(path, "AvailableOnPlatform[CP_XBONE]") == 0 then excludedPlatforms:insert("CP_XBONE") end
	if obj_find_property(path, "AvailableOnPlatform[CP_PS4]") == 0 then excludedPlatforms:insert("CP_PS4") end
	if obj_find_property(path, "AvailableOnPlatform[CP_SWITCH]") == 0 then excludedPlatforms:insert("CP_SWITCH") end
	if obj_find_property(path, "AvailableOnPlatform[CP_PS5]") == 0 then excludedPlatforms:insert("CP_PS5") end
	if obj_find_property(path, "AvailableOnPlatform[CP_XSX]") == 0 then excludedPlatforms:insert("CP_XSX") end
	if obj_find_property(path, "AvailableOnPlatform[CP_IOS]") == 0 then excludedPlatforms:insert("CP_IOS") end
	if obj_find_property(path, "AvailableOnPlatform[CP_ANDROID]") == 0 then excludedPlatforms:insert("CP_ANDROID") end
	return #excludedPlatforms == 0 ? nil : excludedPlatforms
end

print "Processing ExportCustoms..."
for LANGS as lang do
	local ExportCustoms = io.contents(PE_BASE .. "/ExportCustoms_" .. lang .. ".json") |> json.decode|json.withorder|
	for ExportCustoms.ExportCustoms as item do
		if item.name ~= nil then
			local tag = obj_find_property(item.uniqueName, "LocalizeTag")
			if tag[1] == "/" then
				store_tag(lang, item, "name", tag)
			else
				item.name = tag
			end
		end
		if item.description ~= nil then
			local LocalizeDescTag = obj_find_property(item.uniqueName, "LocalizeDescTag") or "/Lotus/Language/Items/GenericSuitCustomizationDesc"
			if LocalizeDescTag[1] == "/" then
				store_tag(lang, item, "description", LocalizeDescTag)
			else
				item.description = LocalizeDescTag
			end
		end
		if lang == "en" then
			item.__order:insert("icon")
			item.icon = obj_find_property(item.uniqueName, "Icon")

			item.__order:insert("productCategory")
			item.productCategory = obj_find_property(to_storeitem(item.uniqueName), "ProductCategory")

			item.__order:insert("alwaysAvailable")
			item.alwaysAvailable = (obj_find_property(item.uniqueName, "AlwaysAvailable") == 1) ? true : nil

			do
				local GenericRequirement, base = obj_find_property(item.uniqueName, "GenericRequirement")
				if GenericRequirement then
					item.__order:insert("requirement")
					item.requirement = obj_resolve_path(base, GenericRequirement)
				end
			end

			if AdditionalItems := obj_find_property(item.uniqueName, "AdditionalItems") then
				if #AdditionalItems ~= 0 then
					item.__order:insert("additionalItems")
					item.additionalItems = {}
					for AdditionalItems as aitem do
						item.additionalItems:insert(obj_resolve_path(item.uniqueName, aitem))
					end
				end
			end

			item.__order:insert("tradable")
			item.tradable = (obj_find_property(item.uniqueName, "TradeCapability") == "RO_ALWAYS")

			--item.__order:insert("recipe")
			--item.recipe = obj_find_property(to_storeitem(item.uniqueName), "DisplayRecipe")

			item.__order:insert("subroutines")
			item.subroutines = obj_find_property(item.uniqueName, "CrewShipUpgrades")

			if RandomizedUpgrades := obj_find_property(item.uniqueName, "RandomizedUpgrades") then
				item.__order:insert("randomisedUpgrades")
				item.randomisedUpgrades = {}
				for RandomizedUpgrades as randomModPath do
					item.randomisedUpgrades:insert({
						__order = { "tag", "range" },
						tag = obj_find_property(randomModPath, "UpgradeEntries")[1].Tag,
						range = obj_find_property(randomModPath, "BasePowerRange")
					})
				end
			end

			if excludedPlatforms := export_excludedPlatforms(item.uniqueName) then
				item.__order:insert("excludedPlatforms")
				item.excludedPlatforms = excludedPlatforms
			end

			if name := dicts.en[item.name] then
				name_to_storeitem_map[name:lower()] = to_storeitem(item.uniqueName)
			end
		end
	end
	for {
		"/Lotus/Upgrades/Skins/Horse/HorseHelmetDrapery",
		"/Lotus/Upgrades/Skins/Horse/HorseSaddleDrapery",
		"/Lotus/Upgrades/Skins/Horse/HorseTailDrapery",
	} as uniqueName do
		local name = obj_find_property(uniqueName, "LocalizeTag")
		local description = obj_find_property(uniqueName, "LocalizeDescTag")
		import_from_languages_bin(name)
		import_from_languages_bin(description)
		ExportCustoms.ExportCustoms:insert({
			__order = { "name", "codexSecret", "description", "icon", "productCategory", "tradable" },
			uniqueName = uniqueName,
			name = name,
			codexSecret = false,
			description = description,
			icon = obj_find_property(uniqueName, "Icon"),
			productCategory = "WeaponSkins",
			tradable = (obj_find_property(uniqueName, "TradeCapability") == "RO_ALWAYS"),
		})
	end
	for ExportCustoms.ExportCustoms as item do
		item.__order:insert("platinumCost")
		item.platinumCost = obj_find_property(item.uniqueName, "PremiumPrice")

		if obj_find_property(to_storeitem(item.uniqueName), "ShowInMarket") == 0 then
			item.__order:insert("excludeFromMarket")
			item.excludeFromMarket = true
		end
	end
	if lang == "en" then
		write_mapped_data_file("ExportCustoms.json", ExportCustoms.ExportCustoms)
	end
end

print "Processing ExportDrones..."
for LANGS as lang do
	local ExportDrones = io.contents(PE_BASE .. "/ExportDrones_" .. lang .. ".json") |> json.decode|json.withorder|
	for ExportDrones.ExportDrones as item do
		store_tag(lang, item, "name", obj_find_property(item.uniqueName, "LocalizeTag"))
		store_tag(lang, item, "description", obj_find_property(item.uniqueName, "LocalizeDescTag"))
		item.specialities = nil
		item.capacityMultiplier = nil

		item.__order:insert(4, "icon")
		item.icon = obj_find_property(item.uniqueName, "Icon")

		do
			local CapacityMultipliers = obj_find_property(item.uniqueName, "CapacityMultipliers")
			item.__order:insert("capacityMultipliers")
			item.capacityMultipliers = {
				__order = { "COMMON", "UNCOMMON", "RARE", "LEGENDARY" },
				COMMON = CapacityMultipliers?.COMMON or error(),
				UNCOMMON = CapacityMultipliers?.UNCOMMON or 4,
				RARE = CapacityMultipliers?.RARE or 1,
				LEGENDARY = 1
			}
		end

		do
			local Probabilities = obj_find_property(item.uniqueName, "Probabilities")
			item.__order:insert("probabilities")
			item.probabilities = {
				__order = { "COMMON", "UNCOMMON", "RARE", "LEGENDARY" },
				COMMON = Probabilities?.COMMON or 0.755,
				UNCOMMON = Probabilities?.UNCOMMON or 0.225,
				RARE = Probabilities?.RARE or 0.02,
				LEGENDARY = 0
			}
		end
	end
	if lang == "en" then
		write_mapped_data_file("ExportDrones.json", ExportDrones.ExportDrones)
	end
end

print "Processing ExportFlavour..."
do
	local palettes = json.decode(io.contents("extras/palettes.json")).data.allPalettes.nodes -- stolen from https://polychrome.seldszar.fr/ (modified: "Satured" -> "Saturated")
	for LANGS as lang do
		local ExportFlavour = io.contents(PE_BASE .. "/ExportFlavour_" .. lang .. ".json") |> json.decode|json.withorder|
		for ExportFlavour.ExportFlavour as item do
			if item.name ~= "" then
				store_tag(lang, item, "name", obj_find_property(item.uniqueName, "LocalizeTag"))
			end
			if item.description ~= "" then
				store_tag(lang, item, "description", obj_find_property(item.uniqueName, "LocalizeDescTag"))
			end

			item.__order:insert(4, "icon")
			item.icon = obj_find_property(item.uniqueName, "Icon")

			item.__order:insert(5, "base")
			item.base = obj_find_base(item.uniqueName)

			item.__order:insert("alwaysAvailable")
			item.alwaysAvailable = (obj_find_property(item.uniqueName, "AlwaysAvailable") == 1) ? true : nil

			item.__order:insert("platinumCost")
			item.platinumCost = obj_find_property(item.uniqueName, "PremiumPrice")

			if obj_find_property(to_storeitem(item.uniqueName), "ShowInMarket") == 0 then
				item.__order:insert("excludeFromMarket")
				item.excludeFromMarket = true
			end

			if item.hexColours and lang == "en" then
				local name_en = dicts.en[item.name]
				if palette := palettes:find(|x| -> x.options and x.options.legacy and x.name == name_en) then
					item.__order:insert("legacyColours")
					item.legacyColours = {}
					for palette.colors as colour do
						local r = (colour >> 16) & 0xff
						local g = (colour >> 8) & 0xff
						local b = colour & 0xff
						item.legacyColours:insert(format_colour(r, g, b))
					end
				end
			end

			if TitleTag := obj_find_property(item.uniqueName, "TitleTag") then
				item.__order:insert("titleTag")
				item.titleTag = TitleTag
				import_from_languages_bin(TitleTag)
			end
		end
		if lang == "en" then
			local missing = {
				"/Lotus/Types/Items/Emotes/GeminiEmote",
			}
			for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/Game/ShipScenes") as path do
				missing:insert(path:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/"))
			end
			for missing as uniqueName do
				local name = obj_find_property(uniqueName, "LocalizeTag")
				local description = obj_find_property(uniqueName, "LocalizeDescTag")
				import_from_languages_bin(name)
				import_from_languages_bin(description)
				ExportFlavour.ExportFlavour:insert({
					uniqueName = uniqueName,
					__order = { "name", "description", "icon", "base" },
					name = name,
					description = description,
					icon = obj_find_property(uniqueName, "Icon"),
					base = obj_find_base(uniqueName),
				})
			end
			write_mapped_data_file("ExportFlavour.json", ExportFlavour.ExportFlavour)
		end
	end
end

print "Processing ExportFusionBundles..."
for LANGS as lang do
	local ExportFusionBundles = io.contents(PE_BASE .. "/ExportFusionBundles_" .. lang .. ".json") |> json.decode|json.withorder|
	for ExportFusionBundles.ExportFusionBundles as item do
		item.__order:insert(2, "name")
		item.name = obj_find_property(item.uniqueName, "LocalizeTag")
		import_from_languages_bin(item.name)

		store_tag(lang, item, "description", obj_find_property(item.uniqueName, "LocalizeDescTag"))

		item.__order:insert(4, "icon")
		item.icon = obj_find_property(item.uniqueName, "Icon")

		item.codexSecret = nil
	end
	if lang == "en" then
		write_mapped_data_file("ExportFusionBundles.json", ExportFusionBundles.ExportFusionBundles)
	end
end

print "Processing ExportGear..."
for LANGS as lang do
	local ExportGear = io.contents(PE_BASE .. "/ExportGear_" .. lang .. ".json") |> json.decode|json.withorder|
	for ExportGear.ExportGear as item do
		store_tag(lang, item, "name", obj_find_property(item.uniqueName, "LocalizeTag"))
		if item.description ~= "" then
			store_tag(lang, item, "description", obj_find_property(item.uniqueName, "LocalizeDescTag"))
		end

		item.__order:insert(4, "icon")
		item.icon = obj_find_property(item.uniqueName, "Icon")

		--item.__order:insert(7, "productCategory")
		--item.productCategory = obj_find_property(to_storeitem(item.uniqueName), "ProductCategory")

		item.__order:insert("purchaseQuantity")
		item.purchaseQuantity = obj_find_property(item.uniqueName, "PurchaseQuantity")

		item.__order:insert("creditsCost")
		item.creditsCost = obj_find_property(item.uniqueName, "RegularPrice")

		item.__order:insert("platinumCost")
		item.platinumCost = obj_find_property(item.uniqueName, "PremiumPrice")

		if obj_find_property(to_storeitem(item.uniqueName), "ShowInMarket") == 0 then
			item.__order:insert("excludeFromMarket")
			item.excludeFromMarket = true
		end

		if name := dicts.en[item.name] then
			name_to_storeitem_map[name:lower()] = to_storeitem(item.uniqueName)
		end
	end
	if lang == "en" then
		write_mapped_data_file("ExportGear.json", ExportGear.ExportGear)
	end
end

local virtuals_tracker = {}

print "Processing ExportKeys..."
local questNameToKey = {}
local keyNameToDroptable = {}
for LANGS as lang do
	local PE_ExportKeys = io.contents(PE_BASE .. "/ExportKeys_" .. lang .. ".json") |> json.decode|json.withorder|
	local ExportKeys = { __order = {} }
	local function add_missionReward(keyUniqueName)
		local credits = obj_find_property_3(keyUniqueName, "Mission", "missionReward", "credits")
		local items = obj_find_property_3(keyUniqueName, "Mission", "missionReward", "items")
		if items then
			items:filter(|x| -> x ~= "")
			if #items == 0 then
				items = nil
			end
		end
		local countedItems = obj_find_property_3(keyUniqueName, "Mission", "missionReward", "countedItems")
		local countedStoreItems = obj_find_property_3(keyUniqueName, "Mission", "missionReward", "countedStoreItems")
		if countedStoreItems then
			countedStoreItems:filter(|x| -> x.StoreItem ~= "")
			if #countedStoreItems == 0 then
				countedStoreItems = nil
			end
		end
		local randomizedItems = obj_find_property_3(keyUniqueName, "Mission", "missionReward", "randomizedItems")
		if randomizedItems == "" then
			randomizedItems = nil
		end
		if credits
			or items
			or countedItems
			or countedStoreItems
			or randomizedItems
		then
			ExportKeys[keyUniqueName].missionReward = {
				__order = { "credits", "items", "countedItems", "countedStoreItems", "droptable" },
				credits = credits,
				items = items,
				countedItems = countedItems,
				countedStoreItems = countedStoreItems,
				droptable = randomizedItems,
			}
			if randomizedItems then
				if name := ExportKeys[keyUniqueName].name then
					name = (dicts.en[name] or name):lower()
					if not ExportKeys[keyUniqueName].excludeFromCodex or not keyNameToDroptable[name] then
						keyNameToDroptable[name] = keyUniqueName == "/Lotus/Types/Keys/ArchwingQuest/MissionOne" ? "/Lotus/Types/Game/MissionDecks/ArchwingCacheCoordsReward" : randomizedItems
					end
				end
			end
		end
	end
	local function add_key(keyUniqueName)
		local obj = obj_from_path(keyUniqueName)
		if not ExportKeys[keyUniqueName] then
			virtuals_tracker[keyUniqueName] = false
			virtuals_tracker[obj.parent] ??= true

			ExportKeys.__order:insert(keyUniqueName)
			local LocalizeTag = obj_find_property(keyUniqueName, "LocalizeTag")
			local LocalizeDescTag = obj_find_property(keyUniqueName, "LocalizeDescTag")
			if LocalizeTag == "" then
				LocalizeTag = nil
			end
			if LocalizeDescTag == "" then
				LocalizeDescTag = nil
			end
			if LocalizeTag and languages_bin_dicts.en[LocalizeTag] then
				import_from_languages_bin(LocalizeTag)
			end
			if LocalizeDescTag and languages_bin_dicts.en[LocalizeDescTag] then
				import_from_languages_bin(LocalizeDescTag)
			end
			ExportKeys[keyUniqueName] = {
				__order = { "name", "description", "parentName", "codexSecret", "excludeFromCodex", "missionReward", "rewards", "cacheRewardManifest", "mission" },
				name = LocalizeTag,
				description = LocalizeDescTag,
				parentName = obj_resolve_path(keyUniqueName, obj.parent),
				codexSecret = (1 == obj_find_property(keyUniqueName, "CodexSecret")),
				excludeFromCodex = (obj_find_property(keyUniqueName, "ExcludeFromCodex") == 1 ? true : nil),
				rewards = {},
				cacheRewardManifest = obj_find_property_2(keyUniqueName, "Mission", "enemyCacheOverride"),
				mission = {
					__order = {"minEnemyLevel", "maxEnemyLevel"},
					minEnemyLevel = obj_find_property_2(keyUniqueName, "Mission", "minEnemyLevel"),
					maxEnemyLevel = obj_find_property_2(keyUniqueName, "Mission", "maxEnemyLevel"),
				},
			}
			add_missionReward(keyUniqueName)
		end
		return obj
	end
	for PE_ExportKeys.ExportKeys as item do
		if lang == "en" then
			questNameToKey[item.name] = item.uniqueName
		end

		store_tag(lang, item, "name", obj_find_property(item.uniqueName, "LocalizeTag"))
		if item.description == "" then
			item.description = nil
		else
			store_tag(lang, item, "description", obj_find_property(item.uniqueName, "LocalizeDescTag"))
		end

		if lang == "en" then
			item.__order:insert(4, "icon")
			item.icon = obj_find_property(item.uniqueName, "Icon")

			item.parentName = obj_from_path(item.uniqueName).parent
			virtuals_tracker[item.uniqueName] = false
			virtuals_tracker[item.parentName] ??= true

			ExportKeys.__order:insert(item.uniqueName)
			ExportKeys[item.uniqueName] = item

			if obj_has_parent(item.uniqueName, "/Lotus/Types/Game/KeyChainItem") then
				assert(item.parentName == "/Lotus/Types/Game/KeyChainItem")

				item.__order:insert("replayable")
				item.replayable = obj_find_property(item.uniqueName, "CanReplay") == 1 ? true : nil

				if ChainStages := obj_find_property(item.uniqueName, "ChainStages") then
					item.__order:insert("chainStages")
					item.chainStages = {}
					for ChainStages as stage do
						local stageKeyUniqueName
						if stage.Key ~= "" then
							stageKeyUniqueName = obj_resolve_path(item.uniqueName, stage.Key)
							local obj = add_key(stageKeyUniqueName)
							if obj.data.QuestRewards?.LOW then
								if obj.data.QuestRewards.LOW.items then
									for obj.data.QuestRewards.LOW.items as storeItem do
										ExportKeys[stageKeyUniqueName].rewards:insert({
											__order = { "rewardType", "itemType" },
											rewardType = "RT_STORE_ITEM",
											itemType = storeItem
										})
									end
								end
								if obj.data.QuestRewards.LOW.credits then
									ExportKeys[stageKeyUniqueName].rewards:insert({
										__order = { "rewardType", "amount" },
										rewardType = "RT_CREDITS",
										amount = obj.data.QuestRewards.LOW.credits
									})
								end
							end
						end
						local stage_parsed = {
							__order = { "key", "itemsToGiveWhenTriggered" },
							key = stageKeyUniqueName,
							itemsToGiveWhenTriggered = stage.ItemsToGiveWhenTriggered
						}
						if stage.MessageToSendWhenTriggered.sub ~= "" then
							stage_parsed.__order:insert("messageToSendWhenTriggered")
							stage_parsed.messageToSendWhenTriggered = export_email(item.uniqueName, stage.MessageToSendWhenTriggered)
						end
						item.chainStages:insert(stage_parsed)
					end
				else
					-- /Lotus/Types/Keys/NewPlayerQuest/NewPlayerQuestKeyChain
				end
			else
				item.__order:insert("missionReward")
				add_missionReward(item.uniqueName)

				item.__order:insert("cacheRewardManifest")
				item.cacheRewardManifest = obj_find_property_2(item.uniqueName, "Mission", "enemyCacheOverride")

				item.__order:insert("mission")
				item.mission = {
					__order = {"minEnemyLevel", "maxEnemyLevel"},
					minEnemyLevel = obj_find_property_2(item.uniqueName, "Mission", "minEnemyLevel"),
					maxEnemyLevel = obj_find_property_2(item.uniqueName, "Mission", "maxEnemyLevel"),
				}
			end

			--print(item.uniqueName)
			if reward := obj_find_property(item.uniqueName, "Reward") then
				--print(dumpvar(reward))
				if reward.RewardType == "RT_RECIPE" or reward.RewardType == "RT_RESOURCE" then
					item.__order:insert("rewards")
					item.rewards = {
						{
							__order = { "rewardType", "itemType", "amount" },
							rewardType = reward.RewardType,
							itemType = reward.ItemType,
							amount = 1
						}
					}
				elseif reward.StoreItemType then
					item.__order:insert("rewards")
					item.rewards = {
						{
							__order = { "rewardType", "itemType" },
							rewardType = "RT_STORE_ITEM",
							itemType = reward.StoreItemType
						}
					}
				end
			end

			item.uniqueName = nil
		end
	end
	if lang == "en" then
		for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/Keys", true) as path do
			if io.isfile(path) then
				local uniqueName = path:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
				if obj_has_parent(uniqueName, "/Lotus/Types/Game/KeyItem") and not ExportKeys[uniqueName] then
					add_key(uniqueName)
				end
			end
		end
		write_data_file("ExportKeys.json", ExportKeys)
	end
end

print "Processing ExportRecipes..."
import_from_languages_bin("/Lotus/Language/Items/BlueprintAndItem")
do
	local ExportRecipes = io.contents(PE_BASE .. "/ExportRecipes.json") |> json.decode|json.withorder|
	for ExportRecipes.ExportRecipes as recipe do
		local result_obj = obj_from_path(to_storeitem(recipe.resultType)) -- archon weapons inherit their names from their non-player counterparts but the storeitem does have the name directly
		if result_obj?.data?.LocalizeTag then
			if languages_bin_dicts.en[result_obj.data.LocalizeTag] then
				name_to_storeitem_map[string.lower(languages_bin_dicts.en[result_obj.data.LocalizeTag].." Blueprint")] = to_storeitem(recipe.uniqueName)
			end
		end
		for recipe.ingredients as ingredient do
			ingredient.ProductCategory = nil
		end
		if #recipe.secretIngredients == 0 then
			recipe.secretIngredients = nil
		else
			recipe.__order:insert(10, "secretIngredientAction")
			recipe.secretIngredientAction = obj_find_property(recipe.uniqueName, "SecretIngredientAction")
		end
	end
	local missing_recipe_types = {
		"/Lotus/Types/Recipes/Railjack/RailjackCephalonBlueprint",

		"/Lotus/Types/Friendly/Pets/CreaturePets/LotusGildCreaturePetBlueprint",
		"/Lotus/Types/Friendly/Pets/MoaPets/LotusGildMoaPetBlueprint",
		"/Lotus/Types/Game/CatbrowPet/CatbrowPetRecipe",
		"/Lotus/Types/Game/CatbrowPet/CatbrowPetUpgradedRecipe",
		"/Lotus/Types/Game/KubrowPet/KubrowPetRecipe",
		"/Lotus/Types/Game/KubrowPet/KubrowPetUpgradedRecipe",
		"/Lotus/Types/Game/KubrowPet/KubrowQuestPetRecipe",
		"/Lotus/Types/Game/KubrowPet/DistillPrintRecipe",
		"/Lotus/Types/Vehicles/Hoverboard/LotusGildHoverboardBlueprint",
		"/Lotus/Weapons/Ostron/Melee/LotusGildWeaponBlueprint",
		"/Lotus/Weapons/Sentients/OperatorAmplifiers/OperatorGildAmpBlueprint",
		"/Lotus/Weapons/Sentients/OperatorAmplifiers/OperatorGildAmpFortunaBlueprint",
		"/Lotus/Weapons/SolarisUnited/LotusGildInfestedKitgunBlueprint",
		"/Lotus/Weapons/SolarisUnited/LotusGildKitgunBlueprint",
	}
	for obj_from_path("/Lotus/Types/Game/Store/InfestedFoundryManifest").data.RecipeItems as uniqueName do
		missing_recipe_types:insert(uniqueName)
	end
	for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/Items/MiscItems/IncarnonAdapters/UnlockerBlueprints") as path do
		local uniqueName = path:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
		if uniqueName ~= "/Lotus/Types/Items/MiscItems/IncarnonAdapters/UnInstallBlueprints/GenericUninstallGenesisAdapterRecipe" then
			missing_recipe_types:insert(uniqueName)
		end
	end
	for missing_recipe_types as uniqueName do
		local recipe = {
			__order = { "uniqueName", "resultType", "buildPrice", "buildTime", "skipBuildTimePrice", "consumeOnUse", "num", "codexSecret", "excludeFromCodex", "hidden", "ingredients", "secretIngredientAction", "secretIngredients" },
			uniqueName = uniqueName,
			resultType = obj_find_property(uniqueName, "ResultItem"):replace("/Lotus/StoreItems/", "/Lotus/"),
			buildPrice = obj_find_property(uniqueName, "BuildPrice") or 0,
			buildTime = obj_find_property(uniqueName, "BuildTime"),
			skipBuildTimePrice = obj_find_property(uniqueName, "SkipBuildTimePrice"),
			consumeOnUse = obj_find_property(uniqueName, "ConsumeOnUse") ~= 0,
			num = 1,
			codexSecret = obj_find_property(uniqueName, "CodexSecret") == 1,
			excludeFromCodex = obj_find_property(uniqueName, "ExcludeFromCodex") ~= 0 ? true : nil,
			--alwaysAvailable = obj_find_property(uniqueName, "AlwaysAvailable") == 1 ? true : nil,
			hidden = true,
			ingredients = obj_find_property(uniqueName, "Ingredients") or {},
			secretIngredientAction = obj_find_property(uniqueName, "SecretIngredientAction"),
			secretIngredients = obj_find_property(uniqueName, "SecretIngredients")
		}
		for recipe.ingredients as ingredient do
			ingredient.ItemType = obj_resolve_path(uniqueName, ingredient.ItemType)
		end
		if recipe.secretIngredients then
			for recipe.secretIngredients as ingredient do
				ingredient.ItemType = obj_resolve_path(uniqueName, ingredient.ItemType)
			end
		end
		if SyndicateStandingChange := obj_find_property(recipe.uniqueName, "SyndicateStandingChange") then
			recipe.__order:insert("syndicateStandingChange")
			recipe.syndicateStandingChange = {
				__order = { "tag", "value" },
				tag = SyndicateStandingChange.Syndicate:split("/"):back(),
				value = obj_find_property_2(recipe.uniqueName, "SyndicateStandingChange", "StandingChange"),
			}
		end
		ExportRecipes.ExportRecipes:insert(recipe)
	end
	for ExportRecipes.ExportRecipes as recipe do 
		recipe.__order:insert("tradable")
		recipe.tradable = (obj_find_property(recipe.uniqueName, "TradeCapability") == "RO_ALWAYS")

		recipe.__order:insert("creditsCost")
		recipe.creditsCost = obj_find_property(recipe.uniqueName, "RegularPrice")

		recipe.__order:insert("platinumCost")
		recipe.platinumCost = obj_find_property(recipe.uniqueName, "PremiumPrice")

		if obj_find_property(to_storeitem(recipe.uniqueName), "ShowInMarket") == 0 then
			recipe.__order:insert("excludeFromMarket")
			recipe.excludeFromMarket = true
		end

		recipe.__order:insert("oneTimePurchasable")
		recipe.oneTimePurchasable = (obj_find_property(recipe.uniqueName, "OneTimePurchasable") == 1) ? true : nil
	end
	write_mapped_data_file("ExportRecipes.json", ExportRecipes.ExportRecipes)
end

print "Processing ExportRegions..."
local MissionData do
	local _sort=table.sort
	table.sort=function() end
	MissionData = load("-- @pluto_warnings disable-all\n"..io.contents("extras/Missions.lua"))()
	table.sort=_sort
end
local DropTables = dofile("extras/DropTables.lua")
do
	local starchart_export = io.contents("extras/starchart-export.json") |> json.decode|json.withorder|
	local system_english_to_tag = {
		Mercury = "/Lotus/Language/Locations/Mercury",
		Venus = "/Lotus/Language/Locations/Venus",
		Earth = "/Lotus/Language/Locations/Earth",
		Mars = "/Lotus/Language/Locations/Mars",
		Jupiter = "/Lotus/Language/Locations/Jupiter",
		Saturn = "/Lotus/Language/Locations/Saturn",
		Uranus = "/Lotus/Language/Locations/Uranus",
		Neptune = "/Lotus/Language/Locations/Neptune",
		Pluto = "/Lotus/Language/Locations/Pluto",
		Ceres = "/Lotus/Language/Locations/Ceres",
		Eris = "/Lotus/Language/Locations/Eris",
		Sedna = "/Lotus/Language/Locations/Sedna",
		Europa = "/Lotus/Language/Locations/Europa",
		Void = "/Lotus/Language/Locations/Void",
		Phobos = "/Lotus/Language/Locations/Phobos",
		Lua = "/Lotus/Language/Locations/Moon",
		Deimos = "/Lotus/Language/InfestedMicroplanet/SolarMapDeimosName",
		Duviri = "/Lotus/Language/Locations/Duviri",
		Zariman = "/Lotus/Language/Zariman/ZarimanRegionName",
	}
	local system_tag_to_index = {
		["/Lotus/Language/Locations/RelayStationSanctuary"] = 20 - 1,
		["/Lotus/Language/Locations/DeepSpace_SPACE"] = 21 - 1,
	}
	local node_tags = {}
	local system_tags = {}

	local factionNameToTag <const> = {
		Grineer = "FC_GRINEER",
		Corpus = "FC_CORPUS",
		Infested = "FC_INFESTATION",
		Corrupted = "FC_OROKIN",
	}
	local factionIndexToTag = {}
	local ExportFactions = { __order = {} }
	for json.decode(io.contents("extras/eFaction.json")) as faction do
		factionIndexToTag[faction.id] = faction.tag
		ExportFactions.__order:insert(faction.tag)
		ExportFactions[faction.tag] = {
			__order = { "index", "name" },
			index = faction.id,
			name = faction.name
		}
		if faction.name then
			import_from_languages_bin(faction.name)
		end
	end
	write_data_file("ExportFactions.json", ExportFactions)

	local missionIndexToTag = {}
	local ExportMissionTypes = { __order = {} }
	for json.decode(io.contents("extras/eMissionType.json")) as missionType do
		missionIndexToTag[missionType.id] = missionType.tag
		ExportMissionTypes.__order:insert(missionType.tag)
		ExportMissionTypes[missionType.tag] = {
			__order = { "index", "name" },
			index = missionType.id,
			name = missionType.name,
		}
		if missionType.name then
			import_from_languages_bin(missionType.name)
		end
	end
	write_data_file("ExportMissionTypes.json", ExportMissionTypes)

	local function fill_in_startchart_export(item)
		if data := starchart_export[item.uniqueName] then
			item.__order:insert("tileset")
			if tileset := data.tileset then
				item.tileset = tileset:split("/"):back() -- for easy indexing into ExportTilesets
			end

			item.__order:insert("levelOverride")
			item.levelOverride = data.levelOverride

			item.__order:insert("extraEnemySpec")
			item.extraEnemySpec = data.extraEnemySpec

			item.__order:insert("vipAgent")
			item.vipAgent = data.vipAgent

			item.__order:insert("customAdvancedSpawners")
			item.customAdvancedSpawners = data.customAdvancedSpawners

			item.__order:insert("missionReward")
			item.missionReward = data.missionReward

			item.__order:insert("miscItemFee")
			item.miscItemFee = data.miscItemFee

			if data.founders then
				item.__order:insert("founders")
				item.founders = data.founders:split(" ")
			end

			item.__order:insert("challenges")
			item.challenges = data.challenges
		end
	end

	local function fill_in_wiki_data(region, mission)
		if mission.Requirements then
			if quest_name := select(3, mission.Requirements:find("Must have %[%[(.+)%]%] completed to access")) then
				quest_name = quest_name:replace(" (Quest)", "")
				region.__order:insert("questReq")
				region.questReq = questNameToKey[quest_name] or error("Failed to resolve "..quest_name)
			end
		end
		do
			local outgoing = {}
			if mission.NextNodes then
				for mission.NextNodes as nextNode do
					if nextNodeData := MissionData.MissionDetails:find(|x| -> x.Name == nextNode) then
						if nextNodeData.InternalName and nextNodeData.InternalName ~= "" then
							outgoing:insert(nextNodeData.InternalName)
						end
					end
				end
			end
			region.__order:insert("nextNodes")
			region.nextNodes = outgoing
		end
	end
	for LANGS as lang do
		local ExportRegions = io.contents(PE_BASE .. "/ExportRegions_" .. lang .. ".json") |> json.decode|json.withorder|
		for ExportRegions.ExportRegions as item do
			if lang == "en" then
				node_tags[item.uniqueName] = switch item.name do
					case "Lith" -> "/Lotus/Language/Locations/Lith"
					case "Oro" -> "/Lotus/Language/Locations/Oro"
					case "Plains of Eidolon" -> "/Lotus/Language/Locations/EidolonPlains"
					case "Vallis" -> "/Lotus/Language/Locations/Vallis"
					case "War" -> "/Lotus/Language/Locations/War"
					case "Titania" -> "/Lotus/Language/Locations/Titania"
					case "Caliban" -> "/Lotus/Language/Locations/Caliban"
					case "Lex" -> "/Lotus/Language/Locations/Lex"
					case "Isos" -> "/Lotus/Language/Locations/Isos"
					case "Saya's Visions" -> "/Lotus/Language/Locations/CetusInvasion"
					case "Rusalka" -> "/Lotus/Language/Locations/Rusalka"
					case "Titan" -> "/Lotus/Language/Locations/Titan"
					case "Legacyte Harvest" -> "/Lotus/Language/1999/1999NodeA"
					case "Faceoff: Squad VS Squad" -> "/Lotus/Language/1999/1999NodeF"
					case "Solstice Square" -> "/Lotus/Language/1999Echoes/1999NodeI"
					--case "Antivirus Bounty" -> "/Lotus/Language/1999Echoes/1999NodeJ"
					case "Descend" -> "/Lotus/Language/TauPrequel/TauPrequelFinal/TauNodeD"
					default -> english_to_tag[item.name]
				end
				system_tags[item.uniqueName] = system_english_to_tag[item.systemName] or english_to_tag[item.systemName]
				system_tag_to_index[system_tags[item.uniqueName]] = item.systemIndex
				if languages_bin_dicts.en[node_tags[item.uniqueName]] ~= item.name then print(item.uniqueName .. " does not have a correct node tag: " .. item.name) end
				if languages_bin_dicts.en[system_tags[item.uniqueName]] ~= item.systemName then print(item.uniqueName .. " does not have a correct system tag: " .. item.systemName) end

				item.__order:insert(7, "missionType")
				item.missionType = missionIndexToTag[item.missionIndex] or error(item.missionIndex)

				item.__order:insert(9, "missionName")
				item.missionName = switch item.uniqueName do
					case "SolNode450", "SolNode719" -> "/Lotus/Language/Missions/MissionName_DualDefense"
					case "SolNode309", "SolNode310" -> "/Lotus/Language/Missions/MissionName_VoidEclipse"
					default -> ExportMissionTypes[item.missionType].name
				end
				if not item.missionName then
					error("Mission type not mapped: "..item.missionIndex)
				end
				import_from_languages_bin(item.missionName)

				item.__order:insert(10, "faction")
				item.faction = factionIndexToTag[item.factionIndex] or error(item.factionIndex)

				item.__order:insert(12, "factionName")
				item.factionName = ExportFactions[item.faction].name

				item.__order:insert("masteryExp")

				fill_in_startchart_export(item)

				item.__order:insert("rewardManifests")
				item.rewardManifests = {}
				if wiki_data := MissionData.MissionDetails:find(|x| -> x.InternalName == item.uniqueName) then
					item.masteryExp = wiki_data.MasteryExp or 0

					if type(wiki_data.Enemy) == "table" then
						assert(#wiki_data.Enemy == 2, item.uniqueName)
						local tag1 = factionNameToTag[wiki_data.Enemy[1]]
						local tag2 = factionNameToTag[wiki_data.Enemy[2]]
						if tag1 ~= item.faction then
							item.__order:insert(13, "secondaryFaction")
							item.__order:insert(14, "secondaryFactionIndex")
							item.__order:insert(15, "secondaryFactionName")
							item.secondaryFaction = tag1
							item.secondaryFactionIndex = ExportFactions[item.secondaryFaction].index
							item.secondaryFactionName = ExportFactions[item.secondaryFaction].name
						elseif tag2 ~= item.faction then
							item.__order:insert(13, "secondaryFaction")
							item.__order:insert(14, "secondaryFactionIndex")
							item.__order:insert(15, "secondaryFactionName")
							item.secondaryFaction = tag2
							item.secondaryFactionIndex = ExportFactions[item.secondaryFaction].index
							item.secondaryFactionName = ExportFactions[item.secondaryFaction].name
						else
							error(item.uniqueName)
						end
					end

					if droptable_wiki_data := DropTables.Missions[wiki_data.DropTableAlias] then
						if droptable_wiki_data.InternalName == nil or droptable_wiki_data.InternalName == "" then
							print($"WIKI DATA ERROR: No InternalName for {wiki_data.DropTableAlias}")
						else
							do
								local InternalName = droptable_wiki_data.InternalName
								if type(InternalName) == "table" then
									InternalName = InternalName[1]
								end
								validate_path(InternalName)
								item.rewardManifests:insert(InternalName)
							end

							if wiki_data.ExtraDropTableAlias then
								validate_path(DropTables.Missions[wiki_data.ExtraDropTableAlias].InternalName)
								item.rewardManifests:insert(DropTables.Missions[wiki_data.ExtraDropTableAlias].InternalName)
							end
						end
					end

					if droptable_wiki_data := DropTables.Missions[wiki_data.CacheDropTableAlias] then
						if droptable_wiki_data.InternalName == nil or droptable_wiki_data.InternalName == "" then
							print($"WIKI DATA ERROR: No InternalName for {wiki_data.CacheDropTableAlias}")
						else
							validate_path(droptable_wiki_data.InternalName)

							item.__order:insert("cacheRewardManifest")
							item.cacheRewardManifest = droptable_wiki_data.InternalName
						end
					end

					if wiki_data.DSResourceBonus then
						item.__order:insert("darkSectorData")
						item.darkSectorData = {
							__order = { "resourceBonus", "xpBonus", "weaponXpBonusFor", "weaponXpBonusVal" },
							resourceBonus = wiki_data.DSResourceBonus,
							xpBonus = wiki_data.DSXPBonus,
							weaponXpBonusFor = wiki_data.DSWeapon,
							weaponXpBonusVal = wiki_data.DSWeaponBonus,
						}
					end

					fill_in_wiki_data(item, wiki_data)
				else
					item.masteryExp = 0

					item.__order:insert("nextNodes")
					item.nextNodes = {}
				end

				item.missionIndex = nil
				item.factionIndex = nil
				item.factionName = nil
				item.secondaryFactionIndex = nil
				item.secondaryFactionName = nil
			end
			store_tag(lang, item, "name", node_tags[item.uniqueName])
			store_tag(lang, item, "systemName", system_tags[item.uniqueName])
		end
		if lang == "en" then
			import_from_languages_bin("/Lotus/Language/Missions/MissionName_Crossfire")
			import_from_languages_bin("/Lotus/Language/Missions/DualDefenseCompare")

			-- insert missing solnodes based on wiki data
			-- nodeType, in order: NT_MISSION, NT_EVENT, NT_PVP, NT_HUB, NT_CLAN, NT_EMPTY, NT_SHORTCUT, NT_JUNCTION, NT_BONUS_MISSION
			for ipairs(MissionData.MissionDetails) as mission do
				if mission.InternalName ~= ""
					and mission.InternalName ~= "ToggleBootLevel"
					and mission.InternalName ~= "GrendelKeyAMissionName"
					and mission.InternalName ~= "GrendelKeyBMissionName"
					and mission.InternalName ~= "GrendelKeyCMissionName"
					and mission.InternalName ~= "/Lotus/Types/Keys/SyndicateCacheHuntBaseKeyItem"
					and not ExportRegions.ExportRegions:find(|x| -> x.uniqueName == mission.InternalName)
				then
					if mission.InternalName == "EventNode763" then
						ExportRegions.ExportRegions:insert({
							__order = { "uniqueName", "name", "systemIndex", "systemName", "nodeType", "masteryReq", "missionType", "missionIndex", "missionName", "faction", "factionIndex", "factionName", "minEnemyLevel", "maxEnemyLevel", "masteryExp", "levelOverride", "enemySpec", "extraEnemySpec", "customAdvancedSpawners", "rewardManifests", "nextNodes", "hidden" },
							uniqueName = "SolNode761",
							name = "/Lotus/Language/GameModes/IndexLowRisk",
							systemIndex = 7,
							systemName = "/Lotus/Language/Locations/Neptune",
							nodeType = 1,
							masteryReq = 0,
							missionType = "MT_ARENA",
							missionName = "/Lotus/Language/Missions/MissionName_Arena",
							faction = "FC_CORPUS",
							minEnemyLevel = 30,
							maxEnemyLevel = 30,
							masteryExp = 0,
							levelOverride = "/Lotus/Levels/CorpusArenas/OutpostArena.level",
							enemySpec = "/Lotus/Types/Game/EnemySpecs/CorpusChampions/CorpusChampions",
							extraEnemySpec = "/Lotus/Types/Game/EnemySpecs/SpecialMissionSpecs/PveGreedAlliedSpecs",
							customAdvancedSpawners = {
								"/Lotus/Types/Enemies/AdvancedSpawners/CorpusModularSpawner"
							},
							rewardManifests = {
								"/Lotus/Types/Game/MissionDecks/CorpusArenaWagerRewardsHard"
							},
							nextNodes = {},
							hidden = true,
						})
						import_from_languages_bin("/Lotus/Language/GameModes/IndexLowRisk")

						ExportRegions.ExportRegions:insert({
							__order = { "uniqueName", "name", "systemIndex", "systemName", "nodeType", "masteryReq", "missionType", "missionIndex", "missionName", "faction", "factionIndex", "factionName", "minEnemyLevel", "maxEnemyLevel", "masteryExp", "levelOverride", "enemySpec", "extraEnemySpec", "customAdvancedSpawners", "rewardManifests", "nextNodes", "hidden" },
							uniqueName = "SolNode762",
							name = "/Lotus/Language/GameModes/IndexMediumRisk",
							systemIndex = 7,
							systemName = "/Lotus/Language/Locations/Neptune",
							nodeType = 1,
							masteryReq = 0,
							missionType = "MT_ARENA",
							missionName = "/Lotus/Language/Missions/MissionName_Arena",
							faction = "FC_CORPUS",
							minEnemyLevel = 30,
							maxEnemyLevel = 30,
							masteryExp = 0,
							levelOverride = "/Lotus/Levels/CorpusArenas/OutpostArena.level",
							enemySpec = "/Lotus/Types/Game/EnemySpecs/CorpusChampions/CorpusChampions",
							extraEnemySpec = "/Lotus/Types/Game/EnemySpecs/SpecialMissionSpecs/PveGreedAlliedSpecs",
							customAdvancedSpawners = {
								"/Lotus/Types/Enemies/AdvancedSpawners/CorpusModularSpawner"
							},
							rewardManifests = {
								"/Lotus/Types/Game/MissionDecks/CorpusArenaWagerRewardsHard"
							},
							nextNodes = {},
							hidden = true,
						})
						import_from_languages_bin("/Lotus/Language/GameModes/IndexMediumRisk")

						ExportRegions.ExportRegions:insert({
							__order = { "uniqueName", "name", "systemIndex", "systemName", "nodeType", "masteryReq", "missionType", "missionIndex", "missionName", "faction", "factionIndex", "factionName", "minEnemyLevel", "maxEnemyLevel", "masteryExp", "levelOverride", "enemySpec", "extraEnemySpec", "customAdvancedSpawners", "rewardManifests", "nextNodes", "hidden" },
							uniqueName = "SolNode763",
							name = "/Lotus/Language/GameModes/IndexHighRisk",
							systemIndex = 7,
							systemName = "/Lotus/Language/Locations/Neptune",
							nodeType = 1,
							masteryReq = 0,
							missionType = "MT_ARENA",
							missionName = "/Lotus/Language/Missions/MissionName_Arena",
							faction = "FC_CORPUS",
							minEnemyLevel = 30,
							maxEnemyLevel = 30,
							masteryExp = 0,
							levelOverride = "/Lotus/Levels/CorpusArenas/OutpostArena.level",
							enemySpec = "/Lotus/Types/Game/EnemySpecs/CorpusChampions/CorpusChampions",
							extraEnemySpec = "/Lotus/Types/Game/EnemySpecs/SpecialMissionSpecs/PveGreedAlliedSpecs",
							customAdvancedSpawners = {
								"/Lotus/Types/Enemies/AdvancedSpawners/CorpusModularSpawner"
							},
							rewardManifests = {
								"/Lotus/Types/Game/MissionDecks/CorpusArenaWagerRewardsHard"
							},
							nextNodes = {},
							hidden = true,
						})
						import_from_languages_bin("/Lotus/Language/GameModes/IndexHighRisk")
					end
					if mission.Planet == "Zariman Ten Zero" then mission.Planet = "Zariman" end
					local nodeType = 0
					if mission.InternalName:find("EventNode") then
						nodeType = 1
					elseif mission.InternalName:find("PvpNode") then
						nodeType = 2
					elseif mission.InternalName:find("Hub") or mission.InternalName:find("HUB") then
						nodeType = 3
					elseif mission.InternalName == "SolNode234" or mission.InternalName == "SolNode714" then
						nodeType = 6
					elseif mission.InternalName:find("Junction") then
						nodeType = 7
					end
					local region = {
						__order = { "uniqueName", "name", "systemIndex", "systemName", "nodeType", "masteryReq", "missionType", "missionIndex", "missionName", "faction", "factionIndex", "factionName", "minEnemyLevel", "maxEnemyLevel", "masteryExp", "rewardManifests" },
						uniqueName = mission.InternalName,
						name = switch mission.InternalName do
							case "SolNode234" -> "/Lotus/Language/Zariman/ZarimanApartment"
							case "SolNode714" -> "/Lotus/Language/Entrati/SolarMapEntratiLabsShortcut"
							case "CetusHub4" -> "/Lotus/Language/Locations/CetusHub"
							case "SolarisUnitedHub1" -> "/Lotus/Language/Locations/SolarisUnitedHub"
							case "PvpNode0" -> "/Lotus/Language/Locations/ConclaveCTF"
							case "PvpNode9" -> "/Lotus/Language/Locations/ConclaveTDM"
							case "PvpNode10" -> "/Lotus/Language/Locations/ConclaveDM"
							case "EntratiLabHub" -> "/Lotus/Language/Entrati/SolarMapEntratiLabsShortcut"
							case "1999Hub" -> "/Lotus/Language/1999/1999HubName"
							default -> english_to_tag[mission.Name] or english_to_tag[mission.Name:upper()]
						end,
						systemName = switch mission.Planet do
							case "Sanctuary Onslaught" -> "/Lotus/Language/Locations/RelayStationSanctuary"
							case "Veil Proxima" -> "/Lotus/Language/Locations/DeepSpace_SPACE"
							default -> system_english_to_tag[mission.Planet] or english_to_tag[mission.Planet]
						end,
						nodeType = nodeType,
						masteryReq = 0,
						missionIndex = switch mission.Type do
							case "Hub", "Relay", "Conclave" -> 10 -- MT_PVP (thanks Void_Glitch, we know hubs are pvp: https://github.com/somemivix/WarframeData-master/blob/master/StarChart.txt)
							case "Solar Rail Junction" -> 23 -- MT_JUNCTION
							case "Sanctuary Onslaught" -> 30 -- MT_ENDLESS_EXTERMINATION
							case "Netracells" -> 37 -- MT_VAULTS
							case "Arena" -> 22 -- MT_ARENA
							case "Assassination" -> 0 -- MT_ASSASSINATION
							case "Ascension" -> 39 -- MT_ASCENSION
							case "Survival" -> 2 -- MT_SURVIVAL
							case "Free Roam" -> 28 -- MT_LANDSCAPE
							--case "Exterminate" -> 1 -- MT_EXTERMINATION
						end,
						missionName = switch mission.Type do
							case "Skirmish", "Free Flight" -> "/Lotus/Language/Missions/MissionName_Railjack"
							case "Assassination" -> "/Lotus/Language/Missions/MissionName_RailjackAssassinate"
							case "Defense" -> "/Lotus/Language/Missions/MissionName_RailjackDefense"
							case "Exterminate" -> "/Lotus/Language/Missions/MissionName_RailjackExterminate"
							case "Orphix" -> "/Lotus/Language/Missions/MissionName_RailjackOrphix"
							case "Spy" -> "/Lotus/Language/Missions/MissionName_RailjackSpy"
							case "Survival" -> "/Lotus/Language/Missions/MissionName_RailjackSurvival"
							case "Volatile" -> "/Lotus/Language/Missions/MissionName_RailjackVolatile"
						end,
						faction = factionNameToTag[mission.Enemy],
						factionIndex = ExportFactions[factionNameToTag[mission.Enemy]]?.index,
						factionName = ExportFactions[factionNameToTag[mission.Enemy]]?.name,
						minEnemyLevel = mission.MinLevel,
						maxEnemyLevel = mission.MaxLevel,
						masteryExp = 0,
						rewardManifests = {},
					}
					if mission.IsRailjack then
						region.missionType = "MT_RAILJACK"
						region.missionIndex = ExportMissionTypes.MT_RAILJACK.index
					else
						assert(region.missionIndex, mission.InternalName)
						region.missionType = missionIndexToTag[region.missionIndex]
						assert(region.missionType, mission.InternalName)
						region.missionName = ExportMissionTypes[region.missionType].name
						assert(region.missionName, mission.InternalName)
					end
					region.systemIndex = system_tag_to_index[region.systemName]
					if not region.systemIndex then
						region.systemIndex = system_tag_to_index[system_english_to_tag[mission.Planet:replace(" Proxima", "")]]
					end
					assert(region.systemIndex, mission.InternalName)
					assert(region.systemName, mission.InternalName)
					ExportRegions.ExportRegions:insert(region)
					import_from_languages_bin(region.name)
					if region.systemName then
						import_from_languages_bin(region.systemName)
					end
					if region.missionName then
						import_from_languages_bin(region.missionName)
					end
					-- Netracells node has no mission deck attached; related: https://onlyg.it/OpenWF/SpaceNinjaServer/issues/2673
					if mission.DropTableAlias ~= "Netracells" then
						if droptable_wiki_data := DropTables.Missions[mission.DropTableAlias] then
							if droptable_wiki_data.InternalName and droptable_wiki_data.InternalName ~= "" then
								validate_path(droptable_wiki_data.InternalName)
								region.rewardManifests = {
									droptable_wiki_data.InternalName
								}
							end
						end
					end
					if droptable_wiki_data := DropTables.Missions[mission.CacheDropTableAlias] then
						if droptable_wiki_data.InternalName == nil or droptable_wiki_data.InternalName == "" then
							print($"WIKI DATA ERROR: No InternalName for {mission.CacheDropTableAlias}")
						else
							validate_path(droptable_wiki_data.InternalName)

							region.__order:insert("cacheRewardManifest")
							region.cacheRewardManifest = droptable_wiki_data.InternalName
						end
					end
					fill_in_startchart_export(region)
					fill_in_wiki_data(region, mission)
					if mission.IsHidden then
						region.__order:insert("hidden")
						region.hidden = true
					end
					region.missionIndex = nil
					region.factionIndex = nil
					region.factionName = nil
					region.secondaryFactionIndex = nil
					region.secondaryFactionName = nil
				end
			end

			write_mapped_data_file("ExportRegions.json", ExportRegions.ExportRegions)
		end
	end
end

local function convert_upgrade_levelStats(item)
	if EnhancementTag := obj_find_property(item.uniqueName, "EnhancementTag") then
		-- If an EnhancementTag is present, it absorbs whatever Upgrades would contribute as |BONUS| or |BONUS1|, |BONUS2|, etc.
		import_from_languages_bin(EnhancementTag)
		for i, level in item.levelStats do
			if #level.stats > 1 then
				-- In this case, the ExtraUpgrades seem to be appended in the offical export, so we need to fix that
				local str = "\r\n" .. level.stats:slice(2):concat("\r\n")
				if level.stats[1]:sub(-#str) == str then
					level.stats[1] = level.stats[1]:sub(1, -#str - 1)
				end
			end
			local res = unsub(dicts.en[EnhancementTag], level.stats[1])
			if res.CONDITION then
				res.CONDITION = obj_find_property(item.uniqueName, "ConditionTag")
				import_from_languages_bin(res.CONDITION)
			end
			if res.BONUS then
				local Upgrades = obj_find_property(item.uniqueName, "Upgrades")
				res.BONUS = unsub_tag(Upgrades[1].LocTag, res.BONUS)
			end
			if res.BONUS1 then
				local Upgrades = obj_find_property(item.uniqueName, "Upgrades")
				if not Upgrades then
					local sub = obj_resolve_path(item.uniqueName, obj_find_property(item.uniqueName, "SubUpgrades")[1])
					Upgrades = obj_find_property(sub, "Upgrades")
				end
				assert(Upgrades, item.uniqueName)
				res.BONUS1 = unsub_tag(Upgrades[1].LocTag, res.BONUS1)
			end
			if res.BONUS2 then
				local Upgrades = obj_find_property(item.uniqueName, "Upgrades")
				res.BONUS2 = unsub_tag(Upgrades[2].LocTag, res.BONUS2)
			end
			if res.BONUS_TEXT and res.BONUS_TEXT ~= "" then
				-- AbilityStrengthOnSummonAttack
				res.BONUS_TEXT = unsub_tag(
					obj_find_property_2(item.uniqueName, "EnhancementTagLocScript", "_giveBonusStatLoc"),
					res.BONUS_TEXT
				)
			end
			level.stats[1] = {
				__order = { "tag", "sub" },
				tag = EnhancementTag,
				sub = res,
			}
			if #level.stats > 1 then
				local ExtraUpgrades = obj_find_property(item.uniqueName, "ExtraUpgrades")
				for j = 2, #level.stats do
					local upgrade = ExtraUpgrades[j - 1]
					level.stats[j] = unsub_tag(upgrade.LocTag, level.stats[j])
				end
			end
			item.levelStats[i] = level.stats
		end
	else
		local Upgrades = obj_find_property(item.uniqueName, "Upgrades")
		--[[if not Upgrades then
			local sub = obj_resolve_path(item.uniqueName, obj_find_property(item.uniqueName, "SubUpgrades")[1])
			Upgrades = obj_find_property(sub, "Upgrades")
		end]]
		local ExtraUpgrades = obj_find_property(item.uniqueName, "ExtraUpgrades")
		for i, level in item.levelStats do
			for j, stat in level.stats do
				local upgrade = j <= #Upgrades ? Upgrades[j] : ExtraUpgrades[j - #Upgrades]
				level.stats[j] = unsub_tag(upgrade.LocTag, stat)
			end
			item.levelStats[i] = level.stats
		end
	end
end

print "Processing ExportRelicArcane..."

local function dofile_patched(path)
	local src = assert(io.contents(path))
	src = src
		:gsub("local%s+Table%s*=%s*require%b()", "-- %0")
		:gsub("\n(%s*addDucatValueKey%s*%(%s*primeData%s*%))", "\n-- %1")
	--[[local r = assert(io.open(path .. ".patched.lua", "wb"))
	r:write(src)
	r:close()]]
	return assert(load(src, "@" .. path))()
end

local wikiVoid = dofile_patched("extras/wiki/Void.lua").RelicData:values()
local wikiVersionData = dofile("extras/wiki/Version.lua")
local ExportRewards = { __order = {} }
do
	local relic_categories = {}
	for LANGS as lang do
		local ExportRelicArcane = io.contents(PE_BASE .. "/ExportRelicArcane_" .. lang .. ".json") |> json.decode|json.withorder|
		local ExportArcanes = {}
		local ExportRelics = {}
		for ExportRelicArcane.ExportRelicArcane as item do
			if item.relicRewards then
				store_tag(lang, item, "description", obj_find_property(item.uniqueName, "LocalizeDescTag"))
				if lang == "en" then
					item.era = item.name:split(" ")[1]
					item.category = item.name:split(" ")[2]
					item.name = nil
					item.__order[2] = "era"
					item.__order:insert(2, "category")
					ExportRelics:insert(item)
					relic_categories[item.uniqueName] = item.category

					item.__order:insert(4, "icon")
					item.icon = obj_find_property(item.uniqueName, "Icon")

					item.__order:insert(7, "quality")
					item.quality = obj_find_property(item.uniqueName, "Quality") or "VPQ_BRONZE"
					--[[item.__order:insert(8, "qualityIndex")
					item.qualityIndex = switch item.quality do
						case "VPQ_BRONZE" -> 0
						case "VPQ_SILVER" -> 1
						case "VPQ_GOLD" -> 2
						case "VPQ_PLATINUM" -> 3
					end]]

					item.__order:insert("rewardManifest")
					item.rewardManifest = obj_find_property(item.uniqueName, "RewardManifest")
					if ExportRewards[item.rewardManifest] == nil then
						ExportRewards.__order:insert(item.rewardManifest)
						ExportRewards[item.rewardManifest] = { item.relicRewards }
						for item.relicRewards as reward do
							reward.__order = { "type", "itemCount", "rarity" }
							reward.type = reward.rewardName
						end
					end
					item.relicRewards = nil

					if item.quality == "VPQ_BRONZE" then
						name_to_storeitem_map[$"{item.era} {item.category} Relic":lower()] = to_storeitem(item.uniqueName) -- Droptables
						name_to_storeitem_map[$"{item.era} {item.category}":lower()] = to_storeitem(item.uniqueName) -- Wiki
					elseif item.quality == "VPQ_PLATINUM" then
						name_to_storeitem_map[$"{item.era} {item.category} Relic (Radiant)":lower()] = to_storeitem(item.uniqueName) -- Droptables
						name_to_storeitem_map[$"{item.era} {item.category} (Radiant)":lower()] = to_storeitem(item.uniqueName) -- Wiki
					end

					if wiki_data := wikiVoid:find(|x| -> x.Name == $"{item.era} {item.category}") then
						local version = (wikiVersionData.Versions[wiki_data.Introduced] or wikiVersionData.Aliases[wiki_data.Introduced])
						item.__order:insert("introducedAt")
						item.introducedAt = version.Timestamp
						if wiki_data.Vaulted then
							item.__order:insert("vaultedAt")
							item.vaultedAt = (wikiVersionData.Versions[wiki_data.Vaulted] or wikiVersionData.Aliases[wiki_data.Vaulted]).Timestamp
						end
					end
				end
			else
				store_tag(lang, item, "name", obj_find_property(item.uniqueName, "LocalizeTag"))
				if lang == "en" then
					if item.levelStats then
						convert_upgrade_levelStats(item)
					end

					item.__order:insert(3, "icon")
					item.icon = obj_find_property(item.uniqueName, "Icon")

					if not item.rarity then
						item.__order:insert("rarity")
						item.rarity = "COMMON"
					end

					item.__order:insert("fusionLimit")
					item.fusionLimit = fusion_level_to_rank(obj_find_property(item.uniqueName, "FusionLimit") or "QA_MEDIUM")

					item.__order:insert("distillPointValue")
					item.distillPointValue = obj_find_property(item.uniqueName, "BaseDistillPointValue")

					if not item.excludeFromCodex then
						name_to_storeitem_map[dicts.en[item.name]:lower()] = to_storeitem(item.uniqueName)
					end
					ExportArcanes:insert(item)
				end
			end
		end
		if lang == "en" then
			for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Upgrades/CosmeticEnhancers", true) as file do
				if io.isfile(file) then
					local path = file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
					local obj = obj_from_path(path)
					if obj.parent == "/Lotus/Types/Game/BaseAntiqueCosmeticEnhancer" then
						local LocalizeTag = obj_find_property(path, "LocalizeTag")
						import_from_languages_bin(LocalizeTag)
						local arcane = {
							__order = { "uniqueName", "name", "icon", "codexSecret", "rarity", "fusionLimit", "distillPointValue" },
							uniqueName = path,
							name = LocalizeTag,
							icon = obj_find_property(path, "Icon"),
							codexSecret = true,
							rarity = obj_find_property(path, "Rarity") or "COMMON",
							fusionLimit = fusion_level_to_rank(obj_find_property(path, "FusionLimit") or "QA_MEDIUM"),
							distillPointValue = obj_find_property(path, "BaseDistillPointValue"),
						}
						assert(not ExportArcanes:find(|x| -> x.uniqueName == path))
						ExportArcanes:insert(arcane)
						name_to_storeitem_map[dicts.en[LocalizeTag]:lower()] = to_storeitem(path)
					end
				end
			end
			write_mapped_data_file("ExportArcanes.json", ExportArcanes)
			write_mapped_data_file("ExportRelics.json", ExportRelics)
			import_from_languages_bin("/Lotus/Language/Relics/VoidProjectionName")
			import_from_languages_bin("/Lotus/Language/Relics/Era_AXI")
			import_from_languages_bin("/Lotus/Language/Relics/Era_LITH")
			import_from_languages_bin("/Lotus/Language/Relics/Era_MESO")
			import_from_languages_bin("/Lotus/Language/Relics/Era_NEO")
			import_from_languages_bin("/Lotus/Language/Relics/Era_OMNI")
			import_from_languages_bin("/Lotus/Language/Relics/Era_REQUIEM")
			import_from_languages_bin("/Lotus/Language/Relics/Era_VANGUARD")
			import_from_languages_bin("/Lotus/Language/Relics/VoidProjectionQuality_Bronze")
			import_from_languages_bin("/Lotus/Language/Relics/VoidProjectionQuality_Gold")
			import_from_languages_bin("/Lotus/Language/Relics/VoidProjectionQuality_Platinum")
			import_from_languages_bin("/Lotus/Language/Relics/VoidProjectionQuality_Silver")
		end
	end
end

print "Processing ExportResources..."
do
	local resource_supplementals = io.contents("extras/resource-supplementals.json") |> json.decode|json.withorder|
	for LANGS as lang do
		local ExportResources = io.contents(PE_BASE .. "/ExportResources_" .. lang .. ".json") |> json.decode|json.withorder|
		for ExportResources.ExportResources as item do
			virtuals_tracker[item.uniqueName] = false
			--virtuals_tracker[item.parentName] ??= true
			--assert(virtuals_tracker[item.parentName] ~= nil)
			if virtuals_tracker[item.parentName] == nil then virtuals_tracker[item.parentName] = true end

			if item.name ~= "" then
				local tag = obj_find_property(item.uniqueName, "LocalizeTag")
				if tag[1] == "/" then
					store_tag(lang, item, "name", tag)
				end
			end
			if item.description ~= "" then
				store_tag(lang, item, "description", obj_find_property(item.uniqueName, "LocalizeDescTag"))
			end
			if item.longDescription then
				store_tag(lang, item, "longDescription", obj_find_property(item.uniqueName, "LongDesc"))
			end

			if lang == "en" then
				item.__order:insert(4, "icon")
				item.icon = obj_find_property(item.uniqueName, "Icon")

				item.__order:insert(7, "productCategory")
				item.productCategory = obj_find_property(to_storeitem(item.uniqueName), "ProductCategory")

				item.__order:insert("rarity")
				item.rarity = obj_find_property(item.uniqueName, "Rarity")

				if item.productCategory == "ShipDecorations" or item.productCategory == "FusionTreasures" then
					item.__order:insert("deco")
					item.deco = obj_resolve_path(item.uniqueName, obj_find_property(item.uniqueName, "Deco"))
					item.__order:insert("capacityCost")
					item.capacityCost = obj_find_property(item.uniqueName, "CapacityCost") or 5
					item.__order:insert("dojoCapacityCost")
					item.dojoCapacityCost = obj_find_property(item.uniqueName, "DojoCapacityCost") or 5
				end

				if item.productCategory == "FusionTreasures" then
					item.__order:insert("sockets")
					item.sockets = {}
					for obj_find_property(item.uniqueName, "Sockets") as ornament do
						item.sockets:insert(obj_resolve_path(item.uniqueName, ornament))
					end
				end

				if item.uniqueName:sub(1, 24) == "/Lotus/Types/Items/Fish/" then
					local storeItem = item.uniqueName:replace("/Lotus/", "/Lotus/StoreItems/")

					item.__order:insert("syndicateTag")
					item.syndicateTag = obj_find_property(storeItem, "SyndicateTag")

					if StandingBonus := obj_find_property(storeItem, "StandingBonus") then
						item.__order:insert("standingBonus")
						item.standingBonus = StandingBonus
					end

					if DissectionParts := obj_find_property(storeItem, "DissectionParts") then
						item.__order:insert("dissectionParts")
						item.dissectionParts = {}
						for DissectionParts.GuaranteedResults as result do
							assert(result.Item.MinCount == result.Item.MaxCount)
							item.dissectionParts:insert({
								__order = { "ItemType", "ItemCount" },
								ItemType = obj_resolve_path(storeItem, result.Item.ItemType),
								ItemCount = result.Item.MinCount,
							})
						end
					end 

					local PropertyValue = obj_find_property(storeItem, "PropertyValue") or "FPC_LOW"
					switch PropertyValue do
						case "FPC_LOW": assert(not "Medium" in storeItem and not "Large" in storeItem) break
						case "FPC_MEDIUM": assert("Medium" in storeItem and not "Large" in storeItem) break
						case "FPC_HIGH": assert("Large" in storeItem and not "Medium" in storeItem) break
					end
				end

				item.__order:insert("platinumCost")
				item.platinumCost = obj_find_property(item.uniqueName, "PremiumPrice")

				if obj_find_property(to_storeitem(item.uniqueName), "ShowInMarket") == 0 then
					item.__order:insert("excludeFromMarket")
					item.excludeFromMarket = true
				end

				item.__order:insert("oneTimePurchasable")
				item.oneTimePurchasable = (obj_find_property(item.uniqueName, "OneTimePurchasable") == 1) ? true : nil

				item.__order:insert("purchaseQuantity")
				item.purchaseQuantity = obj_find_property(item.uniqueName, "PurchaseQuantity")

				if pickupQuantity := resource_supplementals[item.uniqueName] then
					item.__order:insert("pickupQuantity")
					item.pickupQuantity = pickupQuantity
				end

				if name_en := dicts.en[item.name] then
					name_to_storeitem_map[name_en:gsub("<.+>", ""):strip():lower()] = to_storeitem(item.uniqueName)
				end

				-- EclipseVoidWraithItem inherits here. Could use the StoreItem to have it guaranteed without inheritance.
				if InfestedFoundryResourceType := obj_find_property(item.uniqueName, "InfestedFoundryResourceType") then
					if InfestedFoundryResourceType ~= "" then
						item.__order:insert("helminthSnack")
						item.helminthSnack = {
							__order = { "type", "count", "gain" },
							type = InfestedFoundryResourceType,
							count = obj_find_property(item.uniqueName, "InfestedFoundryResourceBundleSize"),
							gain = obj_find_property(item.uniqueName, "InfestedFoundryMaxResourceBinGain")
						}
					end
				end
			end
		end
		if lang == "en" then
			for { "/Lotus/Types/Recipes/Components/VorBoltRemoverFakeItem", "/Lotus/Types/Recipes/Components/BrandRemovalFakeItem" } as uniqueName do
				local name = obj_find_property(uniqueName, "LocalizeTag")
				local description = obj_find_property(uniqueName, "LocalizeDescTag")
				import_from_languages_bin(name)
				import_from_languages_bin(description)
				ExportResources.ExportResources:insert({
					__order = { "name", "description", "icon", "codexSecret", "parentName", "productCategory", "excludeFromCodex" },
					uniqueName = uniqueName,
					name = name,
					description = description,
					icon = obj_find_property(uniqueName, "Icon"),
					codexSecret = obj_find_property(uniqueName, "CodexSecret") == 1,
					parentName = obj_from_path(uniqueName).parent,
					productCategory = obj_find_property(to_storeitem(uniqueName), "ProductCategory"),
					excludeFromCodex = (obj_find_property(uniqueName, "ExcludeFromCodex") ~= 0 ? true : nil),
				})
			end
			write_mapped_data_file("ExportResources.json", ExportResources.ExportResources)
		end
	end
	import_from_languages_bin("/Lotus/Language/Fish/FishDisplayName")
	import_from_languages_bin("/Lotus/Language/Fish/FishSizeLarge")
	import_from_languages_bin("/Lotus/Language/Fish/FishSizeLargeAbbrev")
	import_from_languages_bin("/Lotus/Language/Fish/FishSizeMedium")
	import_from_languages_bin("/Lotus/Language/Fish/FishSizeMediumAbbrev")
	import_from_languages_bin("/Lotus/Language/Fish/FishSizeSmall")
	import_from_languages_bin("/Lotus/Language/Fish/FishSizeSmallAbbrev")
	import_from_languages_bin("/Lotus/Language/SolarisVenus/RobofishAgeCategoryElder")
	import_from_languages_bin("/Lotus/Language/SolarisVenus/RobofishAgeCategoryElderAbbrev")
	import_from_languages_bin("/Lotus/Language/SolarisVenus/RobofishAgeCategoryMature")
	import_from_languages_bin("/Lotus/Language/SolarisVenus/RobofishAgeCategoryMatureAbbrev")
	import_from_languages_bin("/Lotus/Language/SolarisVenus/RobofishAgeCategoryYoung")
	import_from_languages_bin("/Lotus/Language/SolarisVenus/RobofishAgeCategoryYoungAbbrev")
end

print "Processing ExportSentinels..."
local function export_defaultUpgrades(item)
	if DefaultSlottedUpgrades := obj_find_property(item.uniqueName, "DefaultSlottedUpgrades") then
		item.__order:insert("defaultUpgrades")
		item.defaultUpgrades = {}
		for DefaultSlottedUpgrades as slottedUpgrade do
			item.defaultUpgrades:insert({
				__order = { "ItemType", "Slot", --[["RandomUpgradeBuffTags"]] },
				ItemType = obj_resolve_path(item.uniqueName, slottedUpgrade.ItemType),
				Slot = slottedUpgrade.Slot,
				--RandomUpgradeBuffTags = slottedUpgrade.RandomUpgradeBuffTags,
			})
		end
	end
end
for LANGS as lang do
	local ExportSentinels = (io.contents(PE_BASE .. "/ExportSentinels_" .. lang .. ".json") |> json.decode|json.withorder|).ExportSentinels
	for ExportSentinels as item do
		store_tag(lang, item, "name", obj_find_property(item.uniqueName, "LocalizeTag"))
		store_tag(lang, item, "description", obj_find_property(item.uniqueName, "LocalizeDescTag"))

		item.__order:insert(3, "icon")
		item.icon = obj_find_property(item.uniqueName, "Icon")

		item.__order:insert("defaultWeapon")
		item.defaultWeapon = obj_find_property(item.uniqueName, "DefaultWeapon")

		item.__order:insert("exalted")
		item.exalted = obj_find_property(item.uniqueName, "AdditionalItems")--?:map(|x| -> obj_resolve_path(item.uniqueName, x))

		export_defaultUpgrades(item)
	end
	for {
		"/Lotus/Types/Friendly/Pets/MoaPets/MoaPetPowerSuit",
		"/Lotus/Types/Friendly/Pets/ZanukaPets/ZanukaPetAPowerSuit",
		"/Lotus/Types/Friendly/Pets/ZanukaPets/ZanukaPetBPowerSuit",
		"/Lotus/Types/Friendly/Pets/ZanukaPets/ZanukaPetCPowerSuit",
	} as uniqueName do
		local name = obj_find_property(uniqueName, "LocalizeTag")
		local description = obj_find_property(uniqueName, "LocalizeDescTag")
		import_from_languages_bin(name)
		import_from_languages_bin(description)
		local defaultWeapon = obj_find_property(uniqueName, "DefaultWeapon")
		if defaultWeapon then
			defaultWeapon	= obj_resolve_path(uniqueName, defaultWeapon)
		end
		local item = {
			__order = { "name", "icon", "codexSecret", "description", "productCategory", "defaultWeapon", "exalted" },
			uniqueName = uniqueName,
			name = name,
			icon = obj_find_property(uniqueName, "Icon"),
			codexSecret = false,
			description = description,
			productCategory = "MoaPets",
			defaultWeapon = defaultWeapon,
			exalted = obj_find_property(uniqueName, "AdditionalItems"),
		}
		export_defaultUpgrades(item)
		ExportSentinels:insert(item)
	end
	for ExportSentinels as item do
		item.__order:insert("platinumCost")
		item.platinumCost = obj_find_property(item.uniqueName, "PremiumPrice")

		if obj_find_property(to_storeitem(item.uniqueName), "ShowInMarket") == 0 then
			item.__order:insert("excludeFromMarket")
			item.excludeFromMarket = true
		end
	end
	if lang == "en" then
		write_mapped_data_file("ExportSentinels.json", ExportSentinels)
	end
end

print "Processing ExportUpgrades..."
do
	local exclude_mods = io.contents("../warframe-build-evaluator/data-generator/exclude-mods.json") |> json.decode
	local wikiMods = dofile("extras/wiki/Mods.lua").Mods:values()
	for LANGS as lang do
		local ExportUpgrades = io.contents(PE_BASE .. "/ExportUpgrades_" .. lang .. ".json") |> json.decode|json.withorder|
		local missingMods = io.contents("extras/ExportUpgrades-missing.json") |> json.decode|json.withorder|
		for missingMods as mod do
			mod.name = languages_bin_dicts[lang][obj_find_property(mod.uniqueName, "LocalizeTag")]
			ExportUpgrades.ExportUpgrades:insert(mod)
		end
		for ExportUpgrades.ExportUpgrades as upgrade do
			if upgrade.name == "" then
				continue
			end
			store_tag(lang, upgrade, "name", obj_find_property(upgrade.uniqueName, "LocalizeTag") or "/Lotus/Language/Items/EmptyArtifact")
			if upgrade.description then
				assert(#upgrade.description == 1, upgrade.uniqueName)
				upgrade.description = upgrade.description[1]
				store_tag(lang, upgrade, "description", obj_find_property(upgrade.uniqueName, "LocalizeDescTag") or "/Lotus/Language/Items/EmptyArtifactDesc")
			end
			if lang == "en" then
				upgrade.levelStats = nil

				upgrade.__order:insert(3, "icon")
				upgrade.icon = obj_find_property(upgrade.uniqueName, "Icon")

				local offset = upgrade.isUtility ? 10 : 9

				do
					local compat, compat_base = obj_find_property(upgrade.uniqueName, "ItemCompatibility")
					if compat then
						upgrade.__order:insert(offset++, "compat")
						upgrade.compat = obj_resolve_path(compat_base, compat)
					end
				end

				++offset -- Skip compatName

				if CompatibilityTags := obj_find_property(upgrade.uniqueName, "CompatibilityTags") then
					upgrade.__order:insert(offset++, "compatibilityTags")
					upgrade.compatibilityTags = CompatibilityTags
				end

				if IncompatibilityTags := obj_find_property(upgrade.uniqueName, "IncompatibilityTags") then
					upgrade.__order:insert(offset++, "incompatibilityTags")
					upgrade.incompatibilityTags = IncompatibilityTags
				end

				--[[if upgrade.icon == "/Lotus/Interface/Cards/Images/OmegaModIndistinctUnveiled.png" then
					upgrade.__order:insert("omegaUpgradeTypes")
					upgrade.omegaUpgradeTypes = obj_find_property(upgrade.uniqueName, "OmegaUpgradeTypes")
					upgrade.__order:insert("omegaUpgradeWeights")
					upgrade.omegaUpgradeWeights = obj_find_property(upgrade.uniqueName, "OmegaUpgradeWeights")
				else]]if upgrade.icon == "/Lotus/Interface/Cards/Images/OmegaMod.png" then
					upgrade.baseDrain = 10
					upgrade.fusionLimit = 8
				end

				if obj_find_property(upgrade.uniqueName, "IsStarter") == 1 then
					upgrade.__order:insert("isStarter")
					upgrade.isStarter = true
				elseif upgrade.uniqueName:sub(-6) == "SubMod" or exclude_mods[upgrade.uniqueName] == "unreleased/unobtainable" or exclude_mods[upgrade.uniqueName] == "broken (beginner/intermediate)" then
					upgrade.__order:insert("isFrivolous")
					upgrade.isFrivolous = true
				end

				upgrade.__order:insert("tradable")
				upgrade.tradable = (obj_find_property(upgrade.uniqueName, "TradeCapability") ~= "RO_NEVER")

				-- This shit isn't translated in the upstream exports, so using Languages.bin imports.
				if upgrade.upgradeEntries then
					local UpgradeEntries = obj_find_property(upgrade.uniqueName, "UpgradeEntries")
					for i, entry in upgrade.upgradeEntries do
						assert(UpgradeEntries[i].Tag == entry.tag)
						if entry.prefixTag ~= "" then
							--store_tag(lang, entry, "prefixTag", UpgradeEntries[i].LocalizePrefixTag)
							--store_tag(lang, entry, "suffixTag", UpgradeEntries[i].LocalizeSuffixTag)
							entry.prefixTag = UpgradeEntries[i].LocalizePrefixTag
							entry.suffixTag = UpgradeEntries[i].LocalizeSuffixTag
							import_from_languages_bin(entry.prefixTag)
							import_from_languages_bin(entry.suffixTag)
						end
						entry.__order:insert(4, "canBeBuff")
						entry.canBeBuff = (UpgradeEntries[i].CanBeBuff == 1)
						entry.__order:insert(5, "canBeCurse")
						entry.canBeCurse = (UpgradeEntries[i].CanBeCurse == 1)
						for j, sub in entry.upgradeValues do
							if sub.locTag then
								assert(UpgradeEntries[i].Upgrades[j].Schema.LocTag, upgrade.uniqueName)
								--store_tag(lang, sub, "locTag", UpgradeEntries[i].Upgrades[j].Schema.LocTag)
								sub.locTag = UpgradeEntries[i].Upgrades[j].Schema.LocTag
								import_from_languages_bin(sub.locTag)
							end
						end
					end
				elseif not upgrade.isStarter and not upgrade.isFrivolous then
					local name_lower = dicts.en[upgrade.name]:lower()
					name_to_storeitem_map[name_lower] = to_storeitem(upgrade.uniqueName)
					if "orokin" in name_lower then
						name_to_storeitem_map[name_lower--[[:replace("orokin", "corrupted")]]] = to_storeitem(upgrade.uniqueName)
					end
				end
				if upgrade.availableChallenges then
					local AvailableChallenges = obj_find_property(upgrade.uniqueName, "AvailableChallenges")
					for i, challenge in upgrade.availableChallenges do
						assert(AvailableChallenges[i].Challenge == challenge.fullName)

						challenge.description = $"/Lotus/Language/Challenges/Challenge_{challenge.fullName:sub(25)}_Description"
						import_from_languages_bin(challenge.description)

						local orderIndex = 3
						local singleDescriptionTag = $"/Lotus/Language/Challenges/Challenge_{challenge.fullName:sub(25)}_Single_Description"
						if languages_bin_dicts.en[singleDescriptionTag] then
							import_from_languages_bin(singleDescriptionTag)
							challenge.__order:insert(orderIndex, "singleDescription") ++orderIndex
							challenge.singleDescription = singleDescriptionTag
						end

						-- The complications in the OG exports are complete nonsense e.g. for HighSurvivalPacifist
						challenge.complications = {}
						for AvailableChallenges[i].Complications as complication do
							local descTag = $"/Lotus/Language/Challenges/Challenge_Complication_{complication.Complication:sub(39)}"
							import_from_languages_bin(descTag)
							local overrideTag
							if item := obj_find_property(challenge.fullName, "ComplicationOverrideTags")?:find(|x| -> x.complication == complication.Complication:sub(25)) then
								overrideTag = item.tag
								import_from_languages_bin(overrideTag)
							end
							challenge.complications:insert({
								__order = { "fullName", "description", "overrideTag", "countMultiplier", "weight" },
								fullName = complication.Complication,
								description = descTag,
								overrideTag = overrideTag,
								countMultiplier = complication.Multiplier,
								weight = complication.Weight,
							})
						end

						challenge.__order:insert(orderIndex, "countRange") ++orderIndex
						challenge.countRange = AvailableChallenges[i].RequiredCountRange

						challenge.__order:insert(orderIndex, "complicationChance") ++orderIndex
						challenge.complicationChance = AvailableChallenges[i].ComplicationChance
					end
					import_from_languages_bin("/Lotus/Language/Challenges/Challenge_Complication_Combiner")

					upgrade.__order:insert("compatibleItems")
					upgrade.compatibleItems = {}
					for obj_find_property(upgrade.uniqueName, "ItemCompatibilities") as compat do
						if compat.Rarity ~= "NONE" then
							assert(compat.Rarity == "COMMON")
							upgrade.compatibleItems:insert(compat.ItemType)
						end
					end
					if SentinelItemCompatibilities := obj_find_property(upgrade.uniqueName, "SentinelItemCompatibilities") then
						for SentinelItemCompatibilities as compat do
							if compat.Rarity ~= "NONE" then
								assert(compat.Rarity == "COMMON")
								upgrade.compatibleItems:insert(compat.ItemType)
							end
						end
					end
				end

				local wiki_matches = wikiMods:filtered(|x| -> x.InternalName == upgrade.uniqueName):reorder()
				if #wiki_matches ~= 0 then
					if introduced := wiki_matches:map(|x| -> x.Introduced):sort()[1] then
						local version = (wikiVersionData.Versions[introduced] or wikiVersionData.Aliases[introduced])
						assert(version, upgrade.uniqueName)
						upgrade.__order:insert("introducedAt")
						upgrade.introducedAt = version.Timestamp
					end
				end
			end
		end
		if lang == "en" then
			-- https://forums.warframe.com/topic/1435518-scan-aquatic-lifeforms-is-missing-in-the-app-public-export/
			import_from_languages_bin("/Lotus/Language/Mods/LocateCreaturesMod")
			ExportUpgrades.ExportUpgrades:insert({
				uniqueName = "/Lotus/Types/Sentinels/SentinelPrecepts/LocateCreatures",
				__order = { "name", "icon", "polarity", "rarity", "codexSecret", "baseDrain", "fusionLimit", "compat", "excludeFromCodex", "compatName", "type", "canBeTransmutation", "tradable" },
				name = "/Lotus/Language/Mods/LocateCreaturesMod",
				icon = "/Lotus/Interface/Cards/Images/Pets/LocateCreatures.png",
				polarity = "AP_PRECEPT",
				rarity = "COMMON",
				codexSecret = false,
				baseDrain = 0,
				fusionLimit = 3,
				compat = "/Lotus/Types/Sentinels/SentinelPowersuits/RadarBasePowerSuit",
				excludeFromCodex = true,
				compatName = "Oxylus",
				type = "SENTINEL",
				canBeTransmutation = (obj_find_property("/Lotus/Types/Sentinels/SentinelPrecepts/LocateCreatures", "IncludeInBoosterPack") == 1) ? true : nil,
				tradable = (obj_find_property("/Lotus/Types/Sentinels/SentinelPrecepts/LocateCreatures", "TradeCapability") ~= "RO_NEVER"),
			})
		end
		for ExportUpgrades.ExportAvionics as upgrade do
			store_tag(lang, upgrade, "name", obj_find_property(upgrade.uniqueName, "LocalizeTag") or "/Lotus/Language/Items/EmptyArtifact")
			if lang == "en" then
				upgrade.levelStats = nil
				--[[if upgrade.levelStats then
					convert_upgrade_levelStats(upgrade)
				end]]
				if name := dicts.en[upgrade.name] then
					name_to_storeitem_map[name:lower()] = to_storeitem(upgrade.uniqueName)
				end
			end
		end
		for ExportUpgrades.ExportFocusUpgrades as focusUpgrade do
			store_tag(lang, focusUpgrade, "name", obj_find_property(focusUpgrade.uniqueName, "LocalizeTag"))
			if lang == "en" then
				focusUpgrade.__order:insert("description")
				local LocalizeDescTag = obj_find_property(focusUpgrade.uniqueName, "LocalizeDescTag")
				focusUpgrade.description = LocalizeDescTag
				import_from_languages_bin(LocalizeDescTag)
				local description_en = dicts.en[LocalizeDescTag]
				for i, level in focusUpgrade.levelStats do
					assert(#level.stats == 1, focusUpgrade.uniqueName)
					focusUpgrade.levelStats[i] = unsub(description_en, level.stats[1])
				end

				focusUpgrade.__order:insert(3, "icon")
				focusUpgrade.icon = obj_find_property(focusUpgrade.uniqueName, "Icon")

				focusUpgrade.__order:insert("baseFocusPointCost")
				focusUpgrade.baseFocusPointCost = obj_find_property(focusUpgrade.uniqueName, "BaseFocusPointCost")
			end
		end
		if lang == "en" then
			for ExportUpgrades.ExportModSet as modSet do
				modSet.__order:insert(1, "description")
				modSet.description = obj_find_property(modSet.uniqueName, "Upgrades")[1].LocTag
				import_from_languages_bin(modSet.description)

				modSet.__order:insert(2, "icon")
				modSet.icon = obj_find_property(modSet.uniqueName, "ModSetIcon")

				modSet.__order:insert("levelStats")
				modSet.levelStats = {}
				for i, str in modSet.stats do
					modSet.levelStats[i] = unsub(dicts.en[modSet.description], str)
				end
				modSet.stats = nil
			end
			write_mapped_data_file("ExportUpgrades.json", ExportUpgrades.ExportUpgrades)
			write_mapped_data_file("ExportModSet.json", ExportUpgrades.ExportModSet)
			write_mapped_data_file("ExportAvionics.json", ExportUpgrades.ExportAvionics)
			write_mapped_data_file("ExportFocusUpgrades.json", ExportUpgrades.ExportFocusUpgrades)
		end
	end
end

print "Processing ExportSortieRewards..."
--local node_tags = {}
for LANGS as lang do
	local ExportSortieRewards = io.contents(PE_BASE .. "/ExportSortieRewards_" .. lang .. ".json") |> json.decode|json.withorder|
	--[[for ExportSortieRewards.ExportSortieRewards as item do
		item.__order:insert(2, "typeName")
		item.typeName = obj_find_property(item.rewardName, "TypeName")
		item.__order:insert(3, "name")
		item.name = obj_find_property(item.rewardName, "LocalizeTag")
		item.__order:insert(4, "description")
		item.description = obj_find_property(item.rewardName, "LocalizeDescTag")
		item.__order:insert(5, "icon")
		item.icon = obj_find_property(item.rewardName, "Icon")
		import_from_languages_bin(item.name)
		if item.description ~= nil then
			import_from_languages_bin(item.description)
		end
		item.rarity = nil
	end]]
	local ExportNightwave = {
		__order = { "affiliationTag" },
		affiliationTag = ExportSortieRewards.ExportNightwave.affiliationTag,
	}
	$if true then
		ExportNightwave.__order:insert("challenges")
		ExportNightwave.challenges = { __order = {} }
		for ExportSortieRewards.ExportNightwave.challenges as challenge do
			local arr = challenge.uniqueName:split("/")
			store_tag(lang, challenge, "name", $"/Lotus/Language/NightwaveChallenges/Challenge_{arr[#arr]}_Name")
			store_tag(lang, challenge, "description", $"/Lotus/Language/NightwaveChallenges/Challenge_{arr[#arr]}_Description")

			challenge.__order:insert("icon")
			challenge.icon = obj_find_property(challenge.uniqueName, "Icon")

			if TipIcon := obj_find_property(challenge.uniqueName, "TipIcon") then
				challenge.__order:insert("tip")
				challenge.tip = $"/Lotus/Language/NightwaveChallenges/Challenge_{arr[#arr]}_Tip"
				import_from_languages_bin(challenge.tip)

				challenge.__order:insert("tipIcon")
				challenge.tipIcon = TipIcon
			end

			ExportNightwave.challenges.__order:insert(challenge.uniqueName)
			ExportNightwave.challenges[challenge.uniqueName] = challenge
			challenge.uniqueName = nil
		end
	$end
	$if true then
		ExportNightwave.__order:insert("rewards")
		ExportNightwave.rewards = ExportSortieRewards.ExportNightwave.rewards
		for ExportNightwave.rewards as reward do
			reward.__order = { "uniqueName", "name", "description", "icon", "itemCount" }
			if reward.name then
				store_tag(lang, reward, "name", obj_find_property(reward.uniqueName, "LocalizeTag"))
			else
				reward.name = obj_find_property(reward.uniqueName, "LocalizeTag")
				if reward.name then
					import_from_languages_bin(reward.name)
				end
			end
			if reward.description then
				store_tag(lang, reward, "description", obj_find_property(reward.uniqueName, "LocalizeDescTag"))
			else
				reward.description = obj_find_property(reward.uniqueName, "LocalizeDescTag")
				if reward.description == "" then
					reward.description = nil
				else
					import_from_languages_bin(reward.description)
				end
			end
			reward.icon = obj_find_property(reward.uniqueName, "Icon")
			reward.components = nil
		end
	$end
	--[[local ExportRailjack = { nodes = { __order = {} } }
	for ExportSortieRewards.ExportRailjack.nodes as node do
		if lang == "en" then
			node_tags[node.uniqueName] = english_to_tag[node.name]
		end
		store_tag(lang, node, "name", node_tags[node.uniqueName])

		ExportRailjack.nodes.__order:insert(node.uniqueName)
		ExportRailjack.nodes[node.uniqueName] = node
		node.uniqueName = nil
	end]]
	for i, intrinsic in ExportSortieRewards.ExportIntrinsics do
		intrinsic.uniqueName = switch i do
			case 1 -> "LPS_TACTICAL"
			case 2 -> "LPS_PILOTING"
			case 3 -> "LPS_GUNNERY"
			case 4 -> "LPS_ENGINEERING"
			case 5 -> "LPS_COMMAND"
		end

		local tag = switch i do
			case 1 -> "/Lotus/Language/Intrinsics/RailjackIntrinsicTactic"
			case 2 -> "/Lotus/Language/Intrinsics/RailjackIntrinsicPilot"
			case 3 -> "/Lotus/Language/Intrinsics/RailjackIntrinsicGunner"
			case 4 -> "/Lotus/Language/Intrinsics/RailjackIntrinsicEngineer"
			case 5 -> "/Lotus/Language/Intrinsics/RailjackIntrinsicCommand"
		end
		store_tag(lang, intrinsic, "name", tag)

		intrinsic.__order:insert(2, "description")
		intrinsic.description = tag .. "Desc"
		import_from_languages_bin(intrinsic.description)

		intrinsic.__order:insert(3, "icon")
		intrinsic.icon = switch i do
			case 1 -> "/Lotus/Interface/Icons/Intrinsics/IntrinsicsTacticianIcon.png"
			case 2 -> "/Lotus/Interface/Icons/Intrinsics/IntrinsicsPilotingIcon.png"
			case 3 -> "/Lotus/Interface/Icons/Intrinsics/IntrinsicsGunneryIcon.png"
			case 4 -> "/Lotus/Interface/Icons/Intrinsics/IntrinsicsEngineeringIcon.png"
			case 5 -> "/Lotus/Interface/Icons/Intrinsics/IntrinsicsCommandIcon.png"
		end

		for j, rank in intrinsic.ranks do
			store_tag(lang, rank, "name", tag .. "_" .. j)
			store_tag(lang, rank, "description", tag .. "Desc_" .. j)
		end
	end
	--[[for ExportSortieRewards.ExportOther as item do
		store_tag(lang, item, "name", obj_find_property(item.uniqueName, "LocalizeTag"))
		store_tag(lang, item, "description", obj_find_property(item.uniqueName, "LocalizeDescTag"))

		item.__order:insert(4, "icon")
		item.icon = obj_find_property(item.uniqueName, "Icon")
	end]]
	if lang == "en" then
		--write_data_file("ExportSortieRewards.json", ExportSortieRewards.ExportSortieRewards)
		write_data_file("ExportNightwave.json", ExportNightwave)
		write_mapped_data_file("ExportIntrinsics.json", ExportSortieRewards.ExportIntrinsics)
		--write_data_file("ExportRailjack.json", ExportRailjack)
		--write_mapped_data_file("ExportOther.json", ExportSortieRewards.ExportOther)
	end
end

local wikiWarframes = dofile("extras/wiki/Warframes.lua")

print "Processing ExportWarframes..."
local baseSuitToInnateDamageTag = {}
do
	for obj_from_path("/Lotus/Types/Game/Nemesis/KuvaLich/KuvaLichManifest").data.PowerSuits as entry do
		for entry.PlayerSuits as baseSuit do
			baseSuitToInnateDamageTag[baseSuit] = entry.UpgradeTag
		end
	end
	baseSuitToInnateDamageTag["/Lotus/Powersuits/Excalibur/DarkExcalibur"] = "InnateElectricityDamage" -- Fix to make sure Umbra gets nemesisUpgradeTag
end
local function process_ability(lang, ability)
	ability.__order[1] = "uniqueName"
	ability.uniqueName = ability.abilityUniqueName
	ability.abilityUniqueName = nil

	ability.__order[2] = "name"
	ability.name = ability.abilityName
	ability.abilityName = nil

	store_tag(lang, ability, "name", obj_find_property(ability.uniqueName, "LocalizeTag"))
	store_tag(lang, ability, "description", obj_find_property(ability.uniqueName, "LocalizeDescTag"))

	ability.__order:insert(4, "icon")
	ability.icon = obj_find_property(ability.uniqueName, "Icon")

	ability.__order:insert("energyRequiredToActivate")
	ability.energyRequiredToActivate = obj_find_property(ability.uniqueName, "EnergyRequiredToActivate") or 25

	ability.__order:insert("energyConsumptionOverTime")
	ability.energyConsumptionOverTime = obj_find_property(ability.uniqueName, "EnergyConsumptionOverTime")

	--Not every ability has this field, and I'm not sure what the default behaviour is.
	--ability.__order:insert("activationXP")
	--ability.activationXP = obj_find_property(ability.uniqueName, "ActivationXP")
end
for LANGS as lang do
	local ExportWarframes = io.contents(PE_BASE .. "/ExportWarframes_" .. lang .. ".json") |> json.decode|json.withorder|
	local exported_abilities = {}
	local scaled_values_ground_truth = { __order = {} }
	for ExportWarframes.ExportWarframes as warframe do
		store_tag(lang, warframe, "name", obj_find_property(warframe.uniqueName, "LocalizeTag"))
		store_tag(lang, warframe, "description", obj_find_property(warframe.uniqueName, "LocalizeDescTag"))

		warframe.__order:insert(5, "icon")
		warframe.icon = obj_find_property(warframe.uniqueName, "Icon")

		if warframe.longDescription then
			store_tag(lang, warframe, "longDescription", obj_find_property(warframe.uniqueName, "LongDesc"))
		end
		if warframe.passiveDescription then
			store_tag(lang, warframe, "passiveDescription", obj_find_property(warframe.uniqueName, "PassiveAbilityLocTag"))
		end
		for warframe.abilities as ability do
			process_ability(lang, ability)
			exported_abilities[ability.uniqueName] = true
		end

		if lang == "en" then
			warframe.__order:insert("variantType")
			warframe.variantType = obj_find_property(warframe.uniqueName, "VariantType") or "VT_NORMAL"

			if SpecialSlotItem := obj_find_property(warframe.uniqueName, "SpecialSlotItem") then
				if warframe.exalted then
					warframe.exalted = {}
				end
				for SpecialSlotItem.__order as key do
					local specialSlotItem = SpecialSlotItem[key]
					if specialSlotItem.ItemType then
						local ItemType = obj_resolve_path(warframe.uniqueName, specialSlotItem.ItemType)
						if not warframe.exalted then
							warframe.__order:insert("exalted")
							warframe.exalted = {}
						end
						if not ItemType in warframe.exalted then
							warframe.exalted:insert(ItemType)
						end
					end
				end
			end

			if AdditionalItems := obj_find_property(warframe.uniqueName, "AdditionalItems") then
				if #AdditionalItems ~= 0 then
					warframe.__order:insert("additionalItems")
					warframe.additionalItems = {}
					for AdditionalItems as item do
						warframe.additionalItems:insert(obj_resolve_path(warframe.uniqueName, item))
					end
				end
			end

			warframe.__order:insert("nemesisUpgradeTag")
			warframe.nemesisUpgradeTag = baseSuitToInnateDamageTag[warframe.parentName]

			warframe.__order:insert("maxLevelCap")
			warframe.maxLevelCap = obj_find_property(warframe.uniqueName, "LevelCap")

			--[[warframe.__order:insert("levelUpgrades")
			warframe.levelUpgrades = obj_find_property(warframe.uniqueName, "LevelUpgrades"):mapped(|x| -> {
				__order = { "type", "value" },
				type = x.UpgradeType,
				value = x.Value,
			})]]

			do
				scaled_values_ground_truth.__order:insert(warframe.uniqueName)
				scaled_values_ground_truth[warframe.uniqueName] = {}
				local state = {
					__order = { "health", "shield", "power", "armor", "ability_strength", "heal_rate" },
					health = warframe.health,
					shield = warframe.shield,
					power = warframe.power,
					armor = warframe.armor,
					ability_strength = 1.0,
					heal_rate = 0,
				}
				local LevelUpgrades = obj_find_property(warframe.uniqueName, "LevelUpgrades")
				for i = 1, #LevelUpgrades do
					switch LevelUpgrades[i].UpgradeType do
						case "AVATAR_HEALTH_MAX":
							assert(LevelUpgrades[i].OperationType == "ADD_BASE")
							state.health += LevelUpgrades[i].Value
							break

						case "AVATAR_SHIELD_MAX":
							assert(LevelUpgrades[i].OperationType == "ADD_BASE")
							state.shield += LevelUpgrades[i].Value
							break

						case "AVATAR_POWER_MAX":
							assert(LevelUpgrades[i].OperationType == "ADD_BASE")
							state.power += LevelUpgrades[i].Value
							break

						case "AVATAR_ARMOUR":
							assert(LevelUpgrades[i].OperationType == "ADD_BASE")
							state.armor += LevelUpgrades[i].Value
							break

						case "AVATAR_ABILITY_STRENGTH":
							assert(LevelUpgrades[i].OperationType == "STACKING_MULTIPLY")
							state.ability_strength += LevelUpgrades[i].Value
							break

						case "AVATAR_HEAL_RATE":
							assert(LevelUpgrades[i].OperationType == "ADD")
							state.heal_rate += LevelUpgrades[i].Value
							break

						case "NONE":
						case "AVATAR_ENERGY_SPAWN_PERCENT": -- Harrow has this as part of his passive ("Start missions at maximum energy.")
							break

						default:
							error($"Unhandled UpgradeType {LevelUpgrades[i].UpgradeType} for {warframe.uniqueName}")
					end
					scaled_values_ground_truth[warframe.uniqueName][i] = state:clone()
				end
			end

			warframe.__order:insert("platinumCost")
			warframe.platinumCost = obj_find_property(warframe.uniqueName, "PremiumPrice")

			if obj_find_property(to_storeitem(warframe.uniqueName), "ShowInMarket") == 0 then
				warframe.__order:insert("excludeFromMarket")
				warframe.excludeFromMarket = true
			end

			for wikiWarframes as category do
				if wiki_data := category:find(|x| -> x.InternalName == warframe.uniqueName) then
					local version = (wikiVersionData.Versions[wiki_data.Introduced] or wikiVersionData.Aliases[wiki_data.Introduced])
					warframe.__order:insert("introducedAt")
					warframe.introducedAt = version.Timestamp
					break
				end
			end
		end
	end
	for ExportWarframes.ExportAbilities as ability do
		process_ability(lang, ability)
		exported_abilities[ability.uniqueName] = true
	end
	if lang == "en" then
		local paths = {}
		for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/Friendly/PlayerControllable/Abilities") as file do
			if io.isfile(file) then
				paths:insert(file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/"))
			end
		end
		for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Powersuits/PowersuitAbilities") as file do
			if io.isfile(file) then
				paths:insert(file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/"))
			end
		end
		for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/Vehicles/Motorcycle") as file do
			if io.isfile(file) then
				paths:insert(file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/"))
			end
		end
		for paths as path do
			if not exported_abilities[path] and obj_has_parent(path, "/Lotus/Types/Game/PowerSuitAbility") then
				local LocalizeTag = obj_find_property(path, "LocalizeTag")
				local LocalizeDescTag = obj_find_property(path, "LocalizeDescTag")
				if LocalizeTag and languages_bin_dicts.en[LocalizeTag] then
					import_from_languages_bin(LocalizeTag)
				end
				if LocalizeDescTag and languages_bin_dicts.en[LocalizeDescTag] then
					import_from_languages_bin(LocalizeDescTag)
				end
				ExportWarframes.ExportAbilities:insert({
					__order = { "uniqueName", "name", "description", "icon", "energyRequiredToActivate", "energyConsumptionOverTime" },
					uniqueName = path,
					name = LocalizeTag,
					description = LocalizeDescTag,
					icon = obj_find_property(path, "Icon"),
					energyRequiredToActivate = obj_find_property(path, "EnergyRequiredToActivate") or 25,
					energyConsumptionOverTime = obj_find_property(path, "EnergyConsumptionOverTime"),
				})
			end
		end

		write_mapped_data_file("ExportWarframes.json", ExportWarframes.ExportWarframes)
		write_mapped_data_file("ExportAbilities.json", ExportWarframes.ExportAbilities)
		io.contents("scaled_values_ground_truth.json", json.encode(scaled_values_ground_truth, true))
	end
end

local wikiWeapons = {
	primary = dofile("extras/wiki/Weapons/primary.lua"),
	secondary = dofile("extras/wiki/Weapons/secondary.lua"),
	melee = dofile("extras/wiki/Weapons/melee.lua"),
}

print "Processing ExportWeapons..."
local damageTypes = {
	"DT_IMPACT",
	"DT_PUNCTURE",
	"DT_SLASH",
	"DT_FIRE",
	"DT_FREEZE",
	"DT_ELECTRICITY",
	"DT_POISON",
	"DT_EXPLOSION",
	"DT_RADIATION",
	"DT_GAS",
	"DT_MAGNETIC",
	"DT_VIRAL",
	"DT_CORROSIVE",
	"DT_RADIANT",
	"DT_SENTIENT",
	"DT_FINISHER",
}
local function process_attack_data(data): ?table
	if data.Type and data.Type ~= "DT_PHYSICAL" and data.UseNewFormat ~= 1 then
		if data.Amount and data.Amount ~= 0 then
			local damage = { __order = { data.Type, "procChance" } }
			damage[data.Type] = data.Amount
			damage.procChance = data.ProcChance
			return damage
		end
	else
		local factor = (data.UseNewFormat == 1 ? 1 : data.Amount)
		if factor and factor ~= 0 then
			local damage = { __order = {} }
			for damageTypes as damageType do
				local typeAmount = data[damageType] or 0
				if typeAmount ~= 0 then
					damage.__order:insert(damageType)
					damage[damageType] = typeAmount * factor
				end
			end
			damage.__order:insert("procChance")
			damage.procChance = data.ProcChance
			return damage
		end
	end
end
local function process_projectile_attack(path, key, fallbackDamageType: ?string): ?table
	if obj_find_property(path, key) then
		local AttackData = {
			Type = obj_find_property_2(path, key, "Type") or fallbackDamageType,
			Amount = obj_find_property_2(path, key, "Amount"),
			UseNewFormat = obj_find_property_2(path, key, "UseNewFormat"),
			ProcChance = obj_find_property_2(path, key, "ProcChance"),
		}
		if not AttackData.Amount and (AttackData.Type and not fallbackDamageType) then
			AttackData.Amount = 10 -- CorpusChampionRiotRifleProjectile
		end
		for damageTypes as damageType do
			AttackData[damageType] = obj_find_property_2(path, key, damageType)
		end
		return process_attack_data(AttackData)
	end
end
local function process_projectile(path): ?table
	local attack = process_projectile_attack(path, "AttackData")
	local explosiveAttack = process_projectile_attack(path, "ExplosiveAttack", "DT_EXPLOSION")
	local embedDeathAttack = process_projectile_attack(path, "EmbedDeathAttack", "DT_EXPLOSION")
	if attack or embedDeathAttack then
		return {
			__order = { "attack", "explosiveAttack", "embedDeathAttack" },
			attack = attack,
			explosiveAttack = explosiveAttack,
			embedDeathAttack = embedDeathAttack,
		}
	end
end
local function add_weapon_behaviours(weapon, uniqueName)
	if Behaviors := obj_find_property(uniqueName, "Behaviors") then
		weapon.__order:insert("behaviours")
		weapon.behaviours = {}
		for Behaviors as behavior do
			local stateData, fireData, impactData
			for key in behavior do
				if key:sub(1, 6) == "state:" then
					if key ~= "state:Type" then
						stateData = behavior[key]
					end
				elseif key:sub(1, 5) == "fire:" then
					if key ~= "fire:Type" then
						fireData = behavior[key]
					end
				elseif key:sub(1, 7) == "impact:" then
					if key ~= "impact:Type" then
						impactData = behavior[key]
					end
				end
			end
			local projectile, chargedProjectile
			if fireData.projectileType and fireData.projectileType ~= "" then
				if projectilePath := obj_resolve_path(uniqueName, fireData.projectileType) then
					projectile = process_projectile(projectilePath)
				end
			end
			if fireData.chargedProjectileType and fireData.chargedProjectileType ~= "" then
				if projectilePath := obj_resolve_path(uniqueName, fireData.chargedProjectileType) then
					chargedProjectile = process_projectile(projectilePath)
				end
			end
			local LocTag
			if languages_bin_dicts.en[stateData.LocTag] then
				LocTag = stateData.LocTag
				import_from_languages_bin(LocTag)
			end
			local fireIterations, burst
			if fireData.IgnoreFireIterations ~= 1 then
				fireIterations = fireData.fireIterations
			end
			if behavior["state:Type"] == "/EE/Types/Game/WeaponBurstStateBehavior" then
				burst = {
					__order = { "count", "delay" },
					count = stateData.NumShots,
					delay = stateData.BurstDelay,
				}
			end
			weapon.behaviours:insert({
				__order = { "stateName", "fireIterations", "burst", "projectile", "chargedProjectile", "impact" },
				stateName = LocTag,
				fireIterations = fireIterations,
				burst = burst,
				projectile = projectile,
				chargedProjectile = chargedProjectile,
				impact = process_attack_data(impactData.AttackData),
			})
		end
	end
end
local function process_weapon(weapon)
	local name_idx = weapon.__order:findindex(|x| -> x == "name")
	weapon.__order:insert(name_idx + 1, "parentName")
	weapon.parentName = obj_resolve_path(weapon.uniqueName, obj_from_path(weapon.uniqueName).parent)
	virtuals_tracker[weapon.uniqueName] = false
	virtuals_tracker[weapon.parentName] ??= true

	weapon.__order:insert(name_idx + 2, "icon")
	weapon.icon = obj_find_property(weapon.uniqueName, "Icon")

	weapon.__order:insert(weapon.__order:findindex(|x| -> x == "productCategory") + 1, "holsterCategory")
	weapon.holsterCategory = obj_find_property(weapon.uniqueName, "HolsterCategory")

	--[[if obj_find_property(weapon.uniqueName, "EligibleForDailyWeaponSale") == 1 then
		weapon.__order:insert("eligibleForDailyWeaponSale")
		weapon.eligibleForDailyWeaponSale = true
	end]]

	do
		local RegularPrice = obj_find_property(weapon.uniqueName, "RegularPrice")
		if RegularPrice ~= nil and RegularPrice ~= 0 then
			weapon.__order:insert("creditsCost")
			weapon.creditsCost = RegularPrice
		end

		local PremiumPrice = obj_find_property(weapon.uniqueName, "PremiumPrice")
		if PremiumPrice ~= nil and PremiumPrice ~= 0 then
			weapon.__order:insert("platinumCost")
			weapon.platinumCost = PremiumPrice
		end

		if obj_find_property(to_storeitem(weapon.uniqueName), "ShowInMarket") == 0 then
			weapon.__order:insert("excludeFromMarket")
			weapon.excludeFromMarket = true
		end

		weapon.__order:insert("oneTimePurchasable")
		weapon.oneTimePurchasable = (obj_find_property(weapon.uniqueName, "OneTimePurchasable") == 1) ? true : nil
	end

	weapon.__order:insert("compatibilityTags")
	weapon.compatibilityTags = obj_find_property(weapon.uniqueName, "CompatibilityTags")

	weapon.__order:insert("variantType")
	weapon.variantType = obj_find_property(weapon.uniqueName, "VariantType") or "VT_NORMAL"

	add_weapon_behaviours(weapon, weapon.uniqueName)

	if AdditionalItems := obj_find_property(weapon.uniqueName, "AdditionalItems") then
		if #AdditionalItems ~= 0 then
			weapon.__order:insert("additionalItems")
			weapon.additionalItems = {}
			for AdditionalItems as item do
				weapon.additionalItems:insert(obj_resolve_path(weapon.uniqueName, item))
			end
		end
	end

	if AltWeaponType := obj_find_property(weapon.uniqueName, "AltWeaponType") then
		weapon.__order:insert("bayonetOtherWeaponType")
		weapon.bayonetOtherWeaponType = obj_resolve_path(weapon.uniqueName, AltWeaponType)
	end

	if name := dicts.en[weapon.name] then
		name_to_storeitem_map[name:lower()] = to_storeitem(weapon.uniqueName)
	end
end
local function export_weapon_from_packages_bin(path)
	--local obj = obj_from_path(path)
	local LocalizeTag = obj_find_property(path, "LocalizeTag")
	local LocalizeDescTag = obj_find_property(path, "LocalizeDescTag")
	import_from_languages_bin(LocalizeTag)
	if LocalizeDescTag then
		import_from_languages_bin(LocalizeDescTag)
	end
	return {
		__order = { "uniqueName", "name", "codexSecret", --[["damagePerShot", "totalDamage",]] "description", --[["criticalChance", "criticalMultiplier", "procChance", "fireRate",]] "masteryReq", "productCategory", --[["slot", "accuracy",]] "omegaAttenuation", --[["noise", "trigger", "magazineSize", "reloadTime", "multishot"]] },
		uniqueName = path,
		name = LocalizeTag,
		codexSecret = false,
		description = LocalizeDescTag,
		masteryReq = obj_find_property(path, "RequiredLevel"),
		productCategory = obj_find_property(path, "ProductCategory") or "Pistols",
		omegaAttenuation = obj_find_property(path, "OmegaAttenuation") or 0.5,
	}
end
for LANGS as lang do
	local ExportWeapons = io.contents(PE_BASE .. "/ExportWeapons_" .. lang .. ".json") |> json.decode|json.withorder|
	local ExportWeapons_dedup = { __order = {} } -- /Lotus/Weapons/Tenno/Archwing/Primary/ThanoTechArchLongGun/ThanoTechLongGun
	for ExportWeapons.ExportWeapons as weapon do
		if not ExportWeapons_dedup[weapon.uniqueName] then
			store_tag(lang, weapon, "name", obj_find_property(weapon.uniqueName, "LocalizeTag"))
			if weapon.description ~= "" then
				store_tag(lang, weapon, "description", obj_find_property(weapon.uniqueName, "LocalizeDescTag"))
			end

			if lang == "en" then
				process_weapon(weapon)

				export_defaultUpgrades(weapon)

				weapon.__order:insert("tradable")
				weapon.tradable = (obj_find_property(weapon.uniqueName, "TradeCapability") == "RO_ALWAYS")

				-- Modular parts
				if PartType := obj_find_property(weapon.uniqueName, "PartType") then
					weapon.__order:insert("partType")
					weapon.partType = PartType
					if PartType == "LWPT_GUN_BARREL" then
						weapon.__order:insert("gunType")
						weapon.gunType = obj_find_property(weapon.uniqueName, "GunType") or "GT_RIFLE"
					end
				elseif obj_has_parent(weapon.uniqueName, "/Lotus/Types/Weapon/LotusWeaponHilt") then
					weapon.__order:insert("partType")
					weapon.partType = "LWPT_HILT"
				end
				if DonationStandingBonus := obj_find_property(weapon.uniqueName, "DonationStandingBonus") then
					weapon.__order:insert("donationStandingBonus")
					weapon.donationStandingBonus = DonationStandingBonus
				end

				for wikiWeapons as category do
					if wiki_data := category:find(|x| -> x.InternalName == weapon.uniqueName) then
						local version = (wikiVersionData.Versions[wiki_data.Introduced] or wikiVersionData.Aliases[wiki_data.Introduced])
						weapon.__order:insert("introducedAt")
						weapon.introducedAt = version.Timestamp
					end
				end

				ExportWeapons_dedup.__order:insert(weapon.uniqueName)
				ExportWeapons_dedup[weapon.uniqueName] = weapon
				weapon.uniqueName = nil
			end
		end
	end
	for ExportWeapons.ExportRailjackWeapons as weapon do
		store_tag(lang, weapon, "name", obj_find_property(weapon.uniqueName, "LocalizeTag"))
		if weapon.description ~= "" then
			store_tag(lang, weapon, "description", obj_find_property(weapon.uniqueName, "LocalizeDescTag"))
		end
		if lang == "en" then
			process_weapon(weapon)
			export_defaultUpgrades(weapon)
		end
	end
	if lang == "en" then
		local missing_weapons = {
			"/Lotus/Types/Friendly/PlayerControllable/Weapons/DuviriDualSwords", -- Sun & Moon
			"/Lotus/Weapons/Tenno/Melee/Hammer/DaxDuviriHammer/DaxDuviriHammerPlayerWeapon", -- Sampotes
			"/Lotus/Weapons/Tenno/Melee/Polearms/DaxDuviriPolearm/DaxDuviriPolearmSpearPlayerWeapon", -- Edun
			"/Lotus/Weapons/Tenno/Melee/Swords/DaxDuviriKatana/DaxDuviriKatanaPlayerWeapon", -- Syam
			"/Lotus/Weapons/Tenno/Melee/Swords/DaxDuviriTwoHandedKatana/DaxDuviriTwoHandedKatanaPlayerWeapon", -- Azothane
			"/Lotus/Weapons/Tenno/Melee/SwordsAndBoards/DaxDuviriMaceShieldPlayerWeapon", -- Argo & Vel
			"/Lotus/Weapons/Tenno/Bayonet/TnBayonetMeleeWeapon", -- Vinquibus (Melee)
		}
		for missing_weapons as path do
			ExportWeapons_dedup.__order:insert(path)
			ExportWeapons_dedup[path] = export_weapon_from_packages_bin(path)
			process_weapon(ExportWeapons_dedup[path])
			export_defaultUpgrades(ExportWeapons_dedup[path])
			ExportWeapons_dedup[path].__order:insert("tradable")
			ExportWeapons_dedup[path].tradable = (obj_find_property(path, "TradeCapability") == "RO_ALWAYS")
			ExportWeapons_dedup[path].uniqueName = nil
		end
		write_data_file("ExportWeapons.json", ExportWeapons_dedup)

		for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Weapons/CrewShip/Missiles", true) as file do
			if io.isfile(file) then
				local path = file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
				if path ~= "/Lotus/Weapons/CrewShip/Missiles/GhostShipMissileLauncherWeapon"
					and obj_has_parent(path, "/Lotus/Weapons/CrewShip/RailjackOrdnanceWeapon")
				then
					local weapon = export_weapon_from_packages_bin(path)
					process_weapon(weapon)
					export_defaultUpgrades(weapon)
					ExportWeapons.ExportRailjackWeapons:insert(weapon)
				end
			end
		end
		write_mapped_data_file("ExportRailjackWeapons.json", ExportWeapons.ExportRailjackWeapons)
	end
end

print "Creating ExportAchievements..."
do
	local ExportAchievements = { __order = {} }
	for obj_from_path("/Lotus/Types/Challenges/LotusChallengeMgr").data.EnabledChallenges as tag do
		local path = "/Lotus/Types/Challenges/"..tag
		ExportAchievements.__order:insert(tag)
		ExportAchievements[tag] = {
			__order = { "uniqueName", "name", "description", "icon", "hidden", "requiredCount", "progressIndicatorFreq" },
			uniqueName = path,
			name = $"/Lotus/Language/Challenges/Challenge_{tag}_Name",
			description = $"/Lotus/Language/Challenges/Challenge_{tag}_Description",
			icon = obj_find_property(path, "Icon"),
			hidden = obj_find_property(path, "HideChallenge") == 1 ? true : nil,
			requiredCount = obj_find_property(path, "RequiredCount"),
			progressIndicatorFreq = obj_find_property(path, "ProgressIndicatorFreq"),
		}
		if languages_bin_dicts.en[ExportAchievements[tag].name] then
			import_from_languages_bin(ExportAchievements[tag].name)
			import_from_languages_bin(ExportAchievements[tag].description)
		else
			ExportAchievements[tag].name = nil
			ExportAchievements[tag].description = nil
		end
		if Parents := obj_find_property(path, "Parents") then
			for Parents as parentTag do
				if not ExportAchievements[parentTag].children then
					ExportAchievements[parentTag].__order:insert("children")
					ExportAchievements[parentTag].children = {}
				end
				ExportAchievements[parentTag].children:insert(tag)
			end
		end
	end
	write_data_file("ExportAchievements.json", ExportAchievements)
end

print "Creating ExportAnimals..."
do
	local ExportAnimals = { __order = {} }
	for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/NeutralCreatures/Conservation", true) as file do
		if io.isfile(file) then
			local path = file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
			local ItemReward = obj_find_property_2(path, "HuntingInfo", "ItemReward")
			if ItemReward and ItemReward ~= "" then
				local WoundedAnimalReward = obj_find_property_2(path, "HuntingInfo", "WoundedAnimalReward")
				if WoundedAnimalReward == "" then
					WoundedAnimalReward = nil
				end
				local animal = {
					__order = { "name", "description", "icon", "health", "killXPReward", "conservation" },
					name = obj_find_property(path, "LocTag"),
					description = obj_find_property(path, "ShortDesc"),
					icon = obj_find_property(path, "Icon"),
					health = obj_find_property(path, "MaxHealth") or 100,
					killXPReward = obj_find_property(path, "KillXPReward") or 0,
					conservation = {
						__order = { "itemReward", "woundedAnimalReward", "standingReward" },
						itemReward = ItemReward,
						woundedAnimalReward = WoundedAnimalReward,
						standingReward = obj_find_property_2(path, "HuntingInfo", "StandingReward"),
					},
				}
				import_from_languages_bin(animal.name)
				import_from_languages_bin(animal.description)
				ExportAnimals.__order:insert(path)
				ExportAnimals[path] = animal
			end
		end
	end
	write_data_file("ExportAnimals.json", ExportAnimals)
end

print "Creating ExportBoosterPacks..."
do
	local ExportBoosterPacks = { __order = {} }
	for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/BoosterPacks", true) as file do
		if io.isfile(file) then
			local path = file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
			--local obj = obj_from_path(path)
			if path ~= "/Lotus/Types/BoosterPacks/EntratiLabsArcanePackBase"
				and path ~= "/Lotus/Types/BoosterPacks/GreaterRandomProjection"
				and path ~= "/Lotus/Types/BoosterPacks/LotusArtifactUpgradePackBase"
				and path ~= "/Lotus/Types/BoosterPacks/Tennobaum2021PackBase"
				and path ~= "/Lotus/Types/BoosterPacks/1999StickersPackBase"
			then
				--print(path)
				ExportBoosterPacks.__order:insert(path)
				ExportBoosterPacks[path] = {
					__order = { "name", "description", "icon", "components", "rarityWeightsPerRoll", "canGiveDuplicates", "platinumCost" },
					name = obj_find_property(path, "LocalizeTag"),
					description = obj_find_property(path, "LocalizeDescTag"),
					icon = obj_find_property(path, "Icon"),
					components = obj_find_property(path, "Components"),
					rarityWeightsPerRoll = obj_find_property(path, "RarityWeights"),
					canGiveDuplicates = obj_find_property(path, "PreventDuplicates") ~= 1,
					platinumCost = obj_find_property(path, "PremiumPrice"),
				}
				import_from_languages_bin(ExportBoosterPacks[path].name)
				import_from_languages_bin(ExportBoosterPacks[path].description)
				for ExportBoosterPacks[path].components as component do
					component.MinFusionLevel = nil
					component.MaxFusionLevel = nil
					component.Tags = nil

					--component.Amount = nil -- added in 38.6.0
					if not component.Amount then
						component.__order:insert(2, "Amount")
						component.Amount = 1
					end

					-- Probability, IsSpecialItem, and PityIncreaseRate added in 39.0.0
					if component.Probability == 0 then
						component.Probability = nil
					end
					component.IsSpecialItem = nil -- implied by existence of PityIncreaseRate
				end
				if obj_find_property(to_storeitem(path), "ShowInMarket") == 0 then
					ExportBoosterPacks[path].__order:insert("excludeFromMarket")
					ExportBoosterPacks[path].excludeFromMarket = true
				end
			end
		end
	end
	ExportBoosterPacks.__order:sort()
	write_data_file("ExportBoosterPacks.json", ExportBoosterPacks)
end

print "Creating ExportBoosters..."
local booster_store_items = {}
do
	local ExportBoosters = { __order = {} }
	for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/StoreItems/Boosters", true) as file do
		if io.isfile(file) then
			local path = file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
			local obj = obj_from_path(path)
			if obj.parent == "/Lotus/Types/Game/StoreItem" --[[and obj.data.ProductCategory == "Boosters"]]
				and obj.data.Icon -- Exclude Good Stuff and Revive boosters, both unused
			then
				booster_store_items[path] = true

				ExportBoosters.__order:insert(path)
				ExportBoosters[path] = {
					__order = { "name", "description", "icon", "typeName" },
					name = obj.data.LocalizeTag,
					description = obj.data.LocalizeDescTag,
					icon = obj.data.Icon,
					typeName = obj.data.TypeName,
				}

				import_from_languages_bin(obj.data.LocalizeTag)
				import_from_languages_bin(obj.data.LocalizeDescTag)
			end
		end
	end
	write_data_file("ExportBoosters.json", ExportBoosters)
end

print "Creating ExportBundles..."
local LotusGameConfig = obj_from_path("/Lotus/Types/GameRules/LotusGameConfig").data
do
	local ExportBundles = { __order = {} }
	local gifting_bonuses = io.contents("extras/gifting-bonuses.json") |> json.decode
	local bundle_paths = {
		"/Lotus/Types/Game/DuviriEndless/CircuitSteelPathBIGKuvaReward",
		"/Lotus/Types/Items/DiscordItems/DiscordNitroSarynBundle",
		"/Lotus/Types/Items/DiscordItems/DiscordStarterPack2019",
		"/Lotus/Types/Restoratives/Upgraded/DragonKeyRewardBundle",
	}
	for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/StoreItems", true) as path do
		bundle_paths:insert(path:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/"))
	end
	for bundle_paths as uniqueName do
		if PackageComponents := obj_find_property(uniqueName, "PackageComponents") then
			local bundle = {
				__order = { "name", "description", "icon", "excludeFromCodex", "components", "giftingBonus", "creditsCost", "platinumCost", "bundledPlatinum", "platinumBundlePair" },
				name = obj_find_property(uniqueName, "LocalizeTag"),
				description = obj_find_property(uniqueName, "LocalizeDescTag"),
				icon = obj_find_property(uniqueName, "Icon"),
				components = {},
				giftingBonus = gifting_bonuses[uniqueName],
			}
			if bundle.name then
				import_from_languages_bin(bundle.name)
				name_to_storeitem_map[string.lower(languages_bin_dicts.en[bundle.name])] ??= uniqueName
			end
			if bundle.description then
				import_from_languages_bin(bundle.description)
			end

			if obj_find_property(uniqueName, "ExcludeFromCodex") ~= 0 then
				bundle.excludeFromCodex = true
			end

			for PackageComponents as component do
				if component.TypeName ~= "" then
					local typeName = obj_resolve_path(uniqueName, component.TypeName)
					bundle.components:insert({
						__order = { "typeName", "purchaseQuantity", "durabilityDays", "durability", "giveMaxRank" },
						typeName = typeName,
						purchaseQuantity = component.PurchaseQuantity,
						durabilityDays = booster_store_items[typeName] and math.tointeger(LotusGameConfig.UpgradeDurability[component.Durability] / 86400),
						giveMaxRank = (component.GiveMaxRank == 1 ? true : nil)
					})
				end
			end

			bundle.__order:insert("packageDiscount")
			bundle.packageDiscount = obj_find_property(uniqueName, "PackageDiscount")

			bundle.bundledPlatinum = obj_find_property(uniqueName, "BundledPremiumCredits")
			if not bundle.bundledPlatinum then
				bundle.creditsCost = obj_find_property(uniqueName, "RegularPrice")
				bundle.platinumCost = obj_find_property(uniqueName, "PremiumPrice")
			end
			do
				local platinumBundlePair, base = obj_find_property(uniqueName, "PlatinumBundlePair")
				if platinumBundlePair then
					bundle.platinumBundlePair = obj_resolve_path(base, platinumBundlePair)
				end
			end

			if obj_find_property(uniqueName, "ShowInMarket") == 0 then
				bundle.__order:insert("excludeFromMarket")
				bundle.excludeFromMarket = true
			end

			bundle.__order:insert("oneTimePurchasable")
			bundle.oneTimePurchasable = (obj_find_property(uniqueName, "OneTimePurchasable") == 1) ? true : nil

			if excludedPlatforms := export_excludedPlatforms(uniqueName) then
				bundle.__order:insert("excludedPlatforms")
				bundle.excludedPlatforms = excludedPlatforms
			end

			ExportBundles.__order:insert(uniqueName)
			ExportBundles[uniqueName] = bundle
		end
	end
	write_data_file("ExportBundles.json", ExportBundles)
end

print "Creating ExportBounties..."
do
	local ExportBounties = {}
	local function export_bounty(path)
		local obj = obj_from_path(path)
		local job = {
			__order = { "name", "description", "icon", "stages" },
			name = obj.data.LocTag,
			description = obj.data.DescTag,
			icon = obj.data.IconTexture,
			stages = {},
		}
		ExportBounties[path] = job
		for obj.data.Stages as stage do
			local stage_export = {}
			for stage.encounterChoices as choice do
				if choice ~= "" then
					stage_export:insert(choice)
				end
			end
			job.stages:insert(stage_export)
		end
		import_from_languages_bin(obj.data.LocTag)
		import_from_languages_bin(obj.data.DescTag)
	end
	for {
		"/Lotus/Types/Gameplay/Eidolon/Jobs/EidolonJobManifest",
		"/Lotus/Types/Gameplay/Venus/Jobs/VenusJobManifest",
		"/Lotus/Types/Gameplay/InfestedMicroplanet/Jobs/MicroplanetJobManifest",
	} as jm_path do
		local jm = obj_from_path(jm_path)
		for jm.data.Jobs as job do
			export_bounty(obj_resolve_path(jm_path, job))
		end
		if jm.data.ExtraJobs then
			for jm.data.ExtraJobs as job do
				export_bounty(obj_resolve_path(jm_path, job))
			end
		end
		if jm.data.EndlessJobs then
			for jm.data.EndlessJobs as job do
				export_bounty(obj_resolve_path(jm_path, job))
			end
		end
	end
	ExportBounties.__order = ExportBounties:keys():sort()
	write_data_file("ExportBounties.json", ExportBounties)
end

print "Creating ExportChallenges..."
do
	local ExportChallenges = {}
	for obj_from_path("/Lotus/Types/Gameplay/Zariman/Jobs/ZarimanJobManifest").data.ChallengeMissionDifficultyTiers as tier do
		for tier.challenges as entry do
			for entry.challenges as challenge do
				if not ExportChallenges[challenge] then
					local name = challenge:split("/"):back():replace("Easy", ""):replace("VeryHard", ""):replace("Hard", "")
					ExportChallenges[challenge] = {
						__order = { "name", "description", "flavour", "icon", "requiredCount" },
						name = $"/Lotus/Language/Challenges/Challenge_{name}_Name",
						description = $"/Lotus/Language/Challenges/Challenge_{name}_Desc",
						flavour = $"/Lotus/Language/Challenges/Challenge_{name}_Flavor",
						icon = obj_find_property(challenge, "JobBoardIcon"),
						requiredCount = obj_find_property(challenge, "RequiredCount") or 1,
					}
					import_from_languages_bin(ExportChallenges[challenge].name)
					import_from_languages_bin(ExportChallenges[challenge].description)
					import_from_languages_bin(ExportChallenges[challenge].flavour)
				end
			end
		end
	end
	for obj_from_path("/Lotus/Types/Gameplay/EntratiLab/Jobs/EntratiLabsJobManifest").data.ChallengeMissionDifficultyTiers as tier do
		for tier.challenges as entry do
			for entry.challenges as challenge do
				if not ExportChallenges[challenge] then
					local name = challenge:split("/"):back():replace("Easy", ""):replace("VeryHard", ""):replace("Hard", "")
					ExportChallenges[challenge] = {
						__order = { "name", "description", "flavour", "icon", "requiredCount" },
						name = $"/Lotus/Language/EntratiLab/EntratiGeneral/Challenge_{name}_Name",
						description = $"/Lotus/Language/EntratiLab/EntratiGeneral/Challenge_{name}_Desc",
						flavour = $"/Lotus/Language/EntratiLab/EntratiGeneral/Challenge_{name}_Flavor",
						icon = obj_find_property(challenge, "JobBoardIcon"),
						requiredCount = obj_find_property(challenge, "RequiredCount") or 1,
					}
					import_from_languages_bin(ExportChallenges[challenge].name)
					import_from_languages_bin(ExportChallenges[challenge].description)
					import_from_languages_bin(ExportChallenges[challenge].flavour)
				end
			end
		end
	end
	for obj_from_path("/Lotus/Types/Gameplay/1999Wf/Jobs/WF1999JobManifest").data.ChallengeMissionDifficultyTiers as tier do
		for tier.challenges as entry do
			for entry.challenges as challenge do
				if not ExportChallenges[challenge] then
					local name = obj_from_path(challenge).parent
					if name == "VaniaChallengeBase" or name[1] == "/" then
						name = challenge:split("/"):back()
					else
						name = name:replace("Base", "Challenge")
					end
					--print(challenge, name)
					ExportChallenges[challenge] = {
						__order = { "name", "description", "flavour", "icon", "requiredCount" },
						name = $"/Lotus/Language/1999Bounties/Challenge_{name}_Name",
						description = $"/Lotus/Language/1999Bounties/Challenge_{name}_Desc",
						flavour = $"/Lotus/Language/1999Bounties/Challenge_{name}_Flavor",
						icon = obj_find_property(challenge, "JobBoardIcon"),
						requiredCount = obj_find_property(challenge, "RequiredCount") or 1,
					}
					import_from_languages_bin(ExportChallenges[challenge].name)
					import_from_languages_bin(ExportChallenges[challenge].description)
					import_from_languages_bin(ExportChallenges[challenge].flavour)
				end
			end
		end
	end
	for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/Challenges/Seasons", true) as file do
		if io.isfile(file) then
			local challenge = file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
			if Standing := obj_find_property(challenge, "Standing") then
				local name = challenge:split("/"):back()
				if languages_bin_dicts.en[$"/Lotus/Language/NightwaveChallenges/Challenge_{name}_Name"] then
					ExportChallenges[challenge] = {
						__order = { "name", --[["description",]] "icon", "requiredCount", "standing" },
						name = $"/Lotus/Language/NightwaveChallenges/Challenge_{name}_Name",
						--description = $"/Lotus/Language/NightwaveChallenges/Challenge_{name}_Description",
						icon = obj_find_property(challenge, "Icon"),
						requiredCount = obj_find_property(challenge, "RequiredCount") or 1,
						-- tip & tipIcon?
						standing = Standing,
					}
					import_from_languages_bin(ExportChallenges[challenge].name)
					--import_from_languages_bin(ExportChallenges[challenge].description)
				end
			end
		end
	end
	for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/Challenges/Calendar1999", true) as file do
		if io.isfile(file) then
			local challenge = file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
			if challenge:sub(-5) ~= "Base" then
				if name := obj_find_property(challenge, "name") then
					if languages_bin_dicts.en[$"/Lotus/Language/1999Challenges/Challenge_{name}_Name"] then
						ExportChallenges[challenge] = {
							__order = { "name", "description", "icon", "requiredCount" },
							name = $"/Lotus/Language/1999Challenges/Challenge_{name}_Name",
							description = $"/Lotus/Language/1999Challenges/Challenge_{name}_Description",
							icon = obj_find_property(challenge, "Icon"),
							requiredCount = obj_find_property(challenge, "RequiredCount") or 1,
						}
						import_from_languages_bin(ExportChallenges[challenge].name)
						import_from_languages_bin(ExportChallenges[challenge].description)
					end
				end
			end
		end
	end
	local paths = {}
	local challenge_to_countedRewards = {}
	local challenge_to_email = {}
	for obj_from_path("/Lotus/Types/Challenges/PrimaryChallengeManifest").data.ChallengeRewardManifest as challengeReward do
		local path = obj_resolve_path("/Lotus/Types/Challenges/PrimaryChallengeManifest", challengeReward.Challenge)
		paths:insert(path)
		if challengeReward.SilentReward == 1 then
			challenge_to_countedRewards[path] = challengeReward.MsgBoxEntry.att:mapped(|x| -> {
				__order = { "StoreItem", "ItemCount" },
				StoreItem = to_storeitem(x),
				ItemCount = 1,
			})
		elseif #challengeReward.ConditionalRewards ~= 0 and #challengeReward.ConditionalRewards[1].CountedRewards ~= 0 then
			challenge_to_countedRewards[path] = challengeReward.ConditionalRewards[1].CountedRewards
		else
			challenge_to_email[path] = export_email("/Lotus/Types/Challenges/PrimaryChallengeManifest", challengeReward.MsgBoxEntry)
			-- In theory, it should only give what is owned, but based on the limited information I can find, DE may have simply taken the easy way: https://www.reddit.com/r/Warframe/comments/rzlnku/receiving_all_protovyre_armor_evolution_but_only/
			for challengeReward.ConditionalRewards as cr do
				for cr.Rewards as reward do
					challenge_to_email[path].attachments:insert(reward)
				end
			end
		end
	end
	for {
		"/Lotus/Types/Challenges/StarChart",
		"/Lotus/Types/Challenges/Titles"
	} as path do
		for io.listdir(PACKAGES_BIN_BASE .. path) as file do
			if io.isfile(file) then
				local challenge = file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
				if challenge:sub(-5) ~= "Base" then
					paths:insert(challenge)
				end
			end
		end
	end
	for paths as challenge do
		local scope = obj_find_property(challenge, "scope") or "/Lotus/Language/Challenges/"
		local name = obj_find_property(challenge, "name") or challenge:split("/"):back()

		ExportChallenges[challenge] = { __order = {} }

		if languages_bin_dicts.en[$"{scope}Challenge_{name}_Name"] then
			ExportChallenges[challenge].__order:insert("name")
			ExportChallenges[challenge].name = $"{scope}Challenge_{name}_Name"
			import_from_languages_bin(ExportChallenges[challenge].name)
		end

		if languages_bin_dicts.en[$"{scope}Challenge_{name}_Description"] then
			ExportChallenges[challenge].__order:insert("description")
			ExportChallenges[challenge].description = $"{scope}Challenge_{name}_Description"
			import_from_languages_bin(ExportChallenges[challenge].description)
		end

		if languages_bin_dicts.en[$"{scope}Challenge_{name}_Hint"] then
			ExportChallenges[challenge].__order:insert("hint")
			ExportChallenges[challenge].hint = $"{scope}Challenge_{name}_Hint"
			import_from_languages_bin(ExportChallenges[challenge].hint)
		end

		if countedRewards := challenge_to_countedRewards[challenge] then
			ExportChallenges[challenge].__order:insert("countedRewards")
			ExportChallenges[challenge].countedRewards = countedRewards
		end

		if email := challenge_to_email[challenge] then
			ExportChallenges[challenge].__order:insert("message")
			ExportChallenges[challenge].message = email
		end

		if #ExportChallenges[challenge].__order == 0 then
			ExportChallenges[challenge] = nil
		end
	end
	ExportChallenges.__order = ExportChallenges:keys():sort()
	write_data_file("ExportChallenges.json", ExportChallenges)
end

