	write_data_file("ExportEmailItems.json", ExportEmailItems)
end

print "Creating ExportRewards..."
local function bundle_fusion_points(fusion_points)
	if fusion_points == 6000 then
		return "/Lotus/StoreItems/Upgrades/Mods/FusionBundles/CircuitSilverSteelPathFusionBundle", 1
	end
	if (fusion_points % 80) == 0 then
		return "/Lotus/StoreItems/Upgrades/Mods/FusionBundles/RareFusionBundle", (fusion_points // 80)
	elseif (fusion_points % 50) == 0 then
		return "/Lotus/StoreItems/Upgrades/Mods/FusionBundles/UncommonFusionBundle", (fusion_points // 50)
	elseif (fusion_points % 15) == 0 then
		return "/Lotus/StoreItems/Upgrades/Mods/FusionBundles/CommonFusionBundle", (fusion_points // 15)
	else
		error("Could not bundle "..fusion_points.." fusion points")
	end
end
local function computerify_drop(type, probability)
	local itemCount = 1

	-- Resolve "4000 Endo" etc
	if fusion_points := type:match("(%d+) Endo") then
		type, itemCount = bundle_fusion_points(tonumber(fusion_points))
	else
		-- Resolve "6000X Kuva" etc
		do
			local count, name = type:match("(%d+)X (.+)")
			if count and name then
				type = name
				itemCount = tonumber(count)
			end
		end

		-- Resolve "Forma" to "/Lotus/StoreItems/Types/Items/MiscItems/Forma" etc
		if entry := name_to_storeitem_map[type:lower()] then
			type = entry
		else
			if type ~= "Region Resource" then
				print("WARNING: Item type not resolved: "..type)
			end
			type = "/Lotus/StoreItems/RESOLUTION_FAILURE/"..type
		end
	end

	if probability == "Beyond Legendary (Under Review) (0.00%)" then
		probability = 0
	else
		probability = probability:split(" (")[2]:sub(1, -3) / 100
	end

	return {
		__order = { "type", "itemCount", "probability" },
		type = type,
		itemCount = itemCount,
		probability = probability
	}
end
dofile("../pluto-query/query.pluto")
local html = io.contents("extras/droptables.html") |> xml.decode|"html"|
do
	local function prepare_deck(deck_name)
		if deck_name:sub(1, 15) ~= "/Supplementals/" then
			validate_path(deck_name)
		end
		assert(not ExportRewards[deck_name])
		ExportRewards.__order:insert(deck_name)
		ExportRewards[deck_name] = {}
	end

	local table, deck_prefix, deck_suffix, deck, tier, deck_name

	table = xml.query(html, "#sortieRewards + table")
	ExportRewards.__order:insert("/Lotus/Types/Game/MissionDecks/SortieRewards")
	ExportRewards["/Lotus/Types/Game/MissionDecks/SortieRewards"] = { {} }
	for table.children as tr do
		assert(tr.tag == "tr")
		if #tr.children == 2 then
			ExportRewards["/Lotus/Types/Game/MissionDecks/SortieRewards"][1]:insert(computerify_drop(tr.children[1].children[1], tr.children[2].children[1]))
		end
	end

	table = xml.query(html, "#keyRewards + table")
	for table.children as tr do
		assert(tr.tag == "tr")
		if #tr.children == 1 then
			if tr.children[1].children then
				assert(#tr.children[1].children == 1)
				if tr.children[1].children[1] ~= "Rotation A" then
					if tr.children[1].children[1] == "Rotation B" or tr.children[1].children[1] == "Rotation C" then
						if deck then
							tier = {}
							deck:insert(tier)
						end
					elseif uniqueName := keyNameToDroptable[tr.children[1].children[1]:lower()] then
						if uniqueName == "/Lotus/Types/Game/MissionDecks/GalleonRobberiesRewardsC" then
							if not ExportRewards["/Lotus/Types/Game/MissionDecks/GalleonRobberiesRewardsA"] then
								uniqueName = "/Lotus/Types/Game/MissionDecks/GalleonRobberiesRewardsA"
							elseif not ExportRewards["/Lotus/Types/Game/MissionDecks/GalleonRobberiesRewardsB"] then
								uniqueName = "/Lotus/Types/Game/MissionDecks/GalleonRobberiesRewardsB"
							end
						end
						if uniqueName == "/Lotus/Types/Game/MissionDecks/DuviriEncounterRewards/DuviriKullervoSteelPathRNGRewards" and not ExportRewards["/Lotus/Types/Game/MissionDecks/DuviriEncounterRewards/DuviriKullervoNormalRNGRewards"] then
							uniqueName = "/Lotus/Types/Game/MissionDecks/DuviriEncounterRewards/DuviriKullervoNormalRNGRewards"
						end
						--print(tr.children[1].children[1]:lower(), uniqueName)
						if not ExportRewards[uniqueName] then
							tier = {}
							deck = { tier }
							ExportRewards.__order:insert(uniqueName)
							ExportRewards[uniqueName] = deck
							--print("populating "..uniqueName.." from "..tr.children[1].children[1])
						end
					end
				end
			else
				deck = nil
				tier = nil
			end
		elseif #tr.children == 2 then
			if tier then
				tier:insert(computerify_drop(tr.children[1].children[1], tr.children[2].children[1]))
			end
		end
	end

	table = xml.query(html, "#cetusRewards + table")
	for table.children as tr do
		assert(tr.tag == "tr")
		if #tr.children == 1 then
			if tr.children[1].children then
				assert(#tr.children[1].children == 1)
				-- Could xref with EidolonJobManifest
				if tr.children[1].children[1] == "Level 5 - 15 Cetus Bounty" then
					deck_prefix = "/Lotus/Types/Game/MissionDecks/EidolonJobMissionRewards/TierA"
