local function import_from_languages_bin(tag)
	if not dicts.en[tag] then
		tag_order:insert(tag)
		local english = languages_bin_dicts.en[tag]
		assert(english, tag)
		dicts.en[tag] = english
		for EXTRA_LANGS as lang do
			dicts[lang][tag] = languages_bin_dicts[lang]?[tag] ?? english
		end
	end
end

print "Generating reverse map for English..."
local english_to_tag = {}
for key, value in languages_bin_dicts.en do
	if english_to_tag[value] then
		english_to_tag[value] = "NOT UNIQUE"
	else
		english_to_tag[value] = key
	end
end

local function pattern_escape(str)
	return str:split("%"):concat("%%")
	:split("("):concat("%(")
	:split(")"):concat("%)")
	:split("-"):concat("%-")
	:split("+"):concat("%+")
end
local function unsub(init_str, fin_str)
	local res = {
		__order = {}
	}
	if init_str ~= fin_str then
		local schema = init_str:split("|")
		local pattern = ""
		local i = 1
		while i < #schema do
			res.__order:insert(schema[i + 1])
			pattern ..= pattern_escape(schema[i])
			pattern ..= "(.*)"
			i += 2
		end
		pattern ..= pattern_escape(schema[i])
		local matches = { fin_str:match(pattern) }
		assert(#matches == #res.__order)
		for j, key in res.__order do
			res[key] = matches[j]
		end
	end
	return res
end
assert(unsub("|CONDITION|:\r\n|BONUS|", "On Kill:\r\nRefresh Double Jump up to 1x while Airborne.").BONUS == "Refresh Double Jump up to 1x while Airborne.")
assert(unsub("|CONDITION|:\r\n|BONUS| for |DURATION|s", "On 6 Melee Kills within 6s:\r\n+20% Status and Critical Chance for Secondary Weapon for 4s").DURATION == "4")
assert(unsub("Bla |val| bla. |BONUS_TEXT|", "Bla 10 bla. ").val == "10")
assert(unsub("Bla |val| bla. |BONUS_TEXT|", "Bla 10 bla. ").BONUS_TEXT == "")

local function unsub_tag(tag, fin_str)
	import_from_languages_bin(tag)
	return {
		__order = { "tag", "sub" },
		tag = tag,
		sub = unsub(dicts.en[tag], fin_str),
	}
end

local function write_data_file(file, data)
	io.contents(OUTPUT_BASE .. file,
		json.encode(data, true)
			--:replace("    ", "\t")
	)

	$if MSGPACK then
		io.mkdir(OUTPUT_BASE .. "msgpack")
		io.contents(OUTPUT_BASE .. "msgpack/"..file:replace(".json", ".msgpack"), json.encode(data, "msgpack"))
	$end
end

local function map_data(data)
	local obj = { __order = {} }
	for data as item do
		obj.__order:insert(item.uniqueName)
		obj[item.uniqueName] = item
		item.uniqueName = nil
	end
	--obj.__order:sort()
	return obj
end

local function write_mapped_data_file(file, data)
	data = map_data(data)
	io.contents(OUTPUT_BASE .. file,
		json.encode(data, true)
			--:replace("    ", "\t")
	)

	$if MSGPACK then
		io.mkdir(OUTPUT_BASE .. "msgpack")
		io.contents(OUTPUT_BASE .. "msgpack/"..file:replace(".json", ".msgpack"), json.encode(data, "msgpack"))
	$end
end

local function write_string_map_file(file, data)
	write_data_file(file, data)
	--[[local fh = io.open(file, "wb")
	fh:write("{\n")
		local first = true
		for ipairs(data.__order) as key do
			if first then
				first = false
			else
				fh:write(",\n")
			end
			fh:write("    "..json.encode(key)..": "..json.encode(data[key]))
		end
	fh:write("\n}")]]
end

local function to_storeitem(type)
	return "/Lotus/StoreItems/"..type:sub(8)
end

local function from_storeitem(type)
	return "/Lotus/"..type:sub(19)
end

local function format_colour(r, g, b)
	return {
		value = string.format("0x00%02X%02X%02X", r, g, b)
	}
end

local function format_colour_arr(rgba_array)
	local [r, g, b] = rgba_array
	return format_colour(r, g, b)
end

