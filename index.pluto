			{"type":"/Lotus/StoreItems/Upgrades/CosmeticEnhancers/Offensive/InvisibilityOnFinisher","itemCount":1,"probability":0.072},
			{"type":"/Lotus/StoreItems/Upgrades/CosmeticEnhancers/Utility/GolemArcaneAimGlideOnHeadshot","itemCount":1,"probability":0.071},
			{"type":"/Lotus/StoreItems/Upgrades/CosmeticEnhancers/Utility/GolemArcaneBonusDamageOnWallLatch","itemCount":1,"probability":0.071},
		]
	]
}]], json.withorder) do
	if k ~= "__order" then
		assert(ExportRewards[k] == nil)
		ExportRewards.__order:insert(k)
		ExportRewards[k] = v
	end
end
do
	ExportRewards.__order:insert("/Lotus/Types/Game/MissionDecks/EidolonJobMissionRewards/PlagueStarTableSteelPathRewards")
	ExportRewards["/Lotus/Types/Game/MissionDecks/EidolonJobMissionRewards/PlagueStarTableSteelPathRewards"] = ExportRewards["/Lotus/Types/Game/MissionDecks/EidolonJobMissionRewards/PlagueStarTableRewards"]:mapped(function(tier)
		return tier:mapped(function(reward)
			if reward.type == "/Lotus/StoreItems/Types/Items/MiscItems/Kuva" or reward.type == "/Lotus/StoreItems/Upgrades/Mods/FusionBundles/UncommonFusionBundle" then
				reward = reward:mapped(|x| -> x)
				reward.itemCount = math.round(reward.itemCount * 1.25)
			end
			return reward
		end)
	end)
end
ExportRewards.__order:sort()
write_data_file("ExportRewards.json", ExportRewards)

print "Creating ExportEnemies..."
do
	local drops_by_enemy_name = {}
	local function process_table(table, type)
		local items
		local processed_enemy_names = {}
		for table.children as tr do
			if #tr.children == 2 then
				local enemy_name = tr.children[1].children[1]:replace(" (Level 0 - 100)", ""):lower()
				local drop_chance = tonumber(tr.children[2].children[1]:split(": ")[2]:sub(1, -2)) / 100
				if processed_enemy_names[enemy_name] then
					enemy_name ..= " (duplicate)"
				end
				if not processed_enemy_names[enemy_name] then
					processed_enemy_names[enemy_name] = true
					items = {}
					drops_by_enemy_name[enemy_name] ??= {}
					drops_by_enemy_name[enemy_name]:insert({
						__order = { "type", "chance", "items" },
						type = type,
						chance = drop_chance,
						items = items
					})
				else
					items = nil
				end
			elseif #tr.children == 3 then
				if items then
					local drop
					local dropName = tr.children[2].children[1]
					if dropName == "Powercell" then
						drop = {
							__order = { "type", "probability" },
							type = "/Lotus/Types/PickUps/ExcavatorCellItem",
							probability = 1.0
						}
					elseif dropName == "Gas Can" then
						drop = {
							__order = { "type", "probability" },
							type = "/Lotus/Types/Gameplay/1999Wf/PvPvE/Objectives/ExcavatorCellItem",
							probability = 1.0
						}
					elseif dropName == "Albumchip" then
						drop = {
							__order = { "type", "probability" },
							type = "/Lotus/Types/PickUps/InfestedLichChipItem",
							probability = 1.0
						}
					else
						drop = computerify_drop(dropName, tr.children[3].children[1])
						if drop.itemCount ~= 1 then
							print("WARNING: Did not expect itemCount: "..dropName)
							drop.type = "/Lotus/StoreItems/RESOLUTION_FAILURE/"..dropName
						end
						drop.type = from_storeitem(drop.type)
						drop.itemCount = nil
					end
					items:insert(drop)
				end
			end
		end
	end
	process_table(xml.query(html, "#modByAvatar + table"), "mod")
	process_table(xml.query(html, "#blueprintByAvatar + table"), "blueprint")
	process_table(xml.query(html, "#resourceByAvatar + table"), "resource")
	process_table(xml.query(html, "#sigilByAvatar + table"), "sigil")
	process_table(xml.query(html, "#additionalItemByAvatar + table"), "additionalItem")
	process_table(xml.query(html, "#relicByAvatar + table"), "relic")

	local procTypes <const> = {
		"PT_KNOCKBACK",
		"PT_FRAILTY",
		"PT_BLEEDING",
		"PT_IMMOLATION",
		"PT_CHILLED",
		"PT_ELECTROCUTION",
		"PT_POISONED",
		"PT_FLASHBANG",
		"PT_RAD_TOX",
		"PT_ASPHYXIATION",
		"PT_MAGNETIZED",
		"PT_INFECTED",
		"PT_CAUSTIC_BURN",
		"PT_RADIANT",
		"PT_STAGGERED",
		"PT_BIG_STAGGER",
		"PT_STUNNED",
		"PT_KNOCKED_DOWN",
		"PT_RAGDOLL",
	}

	local ExportEnemies = {
		__order = { "agents", "avatars", "damageControllers", "droptables", "hitProxies", "aiWeapons" },
		agents = { __order = {} },
		avatars = { __order = {} },
		damageControllers = { __order = {} },
		droptables = { __order = {} },
		hitProxies = { __order = {} },
		aiWeapons = { __order = {} },
	}
	local function process_enemy_avatar(path)
		if ExportEnemies.avatars[path] then
		elseif Faction := obj_find_property(path, "Faction") then
			if LocTag := obj_find_property(path, "LocTag") then
				if name := languages_bin_dicts.en[LocTag] then
					local DamageControllerType, DamageControllerType_path_base = obj_find_property(path, "DamageControllerType")
					DamageControllerType = obj_resolve_path(DamageControllerType_path_base, DamageControllerType)
					if DamageControllerType then
						local DropTable, DropTable_path_base = obj_find_property(path, "DropTable")
						if DropTable then
							DropTable = obj_resolve_path(DropTable_path_base, DropTable)
							if DropTable then
								if not ExportEnemies.droptables[DropTable] then
									name = name:lower()
									if drops_by_enemy_name[name] then
										ExportEnemies.droptables.__order:insert(DropTable)
										ExportEnemies.droptables[DropTable] = drops_by_enemy_name[name]
									else
										-- No listed drops, no point in including this.
										DropTable = nil
									end
								end
							end
						end

						local InjuryHandlersEx = obj_find_property(DamageControllerType, "InjuryHandlersEx") or {}
						local unhandledProcTypes = {}
						for procTypes as procType do
							if not InjuryHandlersEx[procType] then
								unhandledProcTypes:insert(procType)
							end
						end

						local killXPReward = obj_find_property(path, "KillXPReward")
						local codexScansRequired = obj_find_property(path, "CodexScansRequiredOverride")
						if not codexScansRequired then
							if obj_find_property(path, "AvatarEnhancements") then
								codexScansRequired = 3
							elseif killXPReward then
								codexScansRequired = 5
							else
								codexScansRequired = 20
							end
						end
						switch path do
							case "/Lotus/Types/Enemies/Grineer/AIWeek/Avatars/RifleLancerAvatar":
								assert(codexScansRequired == 20, path)
								break

							case "/Lotus/Types/Enemies/Grineer/AIWeek/Avatars/EliteRifleLancerAvatar":
							case "/Lotus/Types/Enemies/SpaceBattles/Corpus/Ships/LaserShipAvatar":
							case "/Lotus/Types/Enemies/Corpus/Spaceman/EliteSpacemanAvatar":
							case "/Lotus/Types/Enemies/Grineer/SeaLab/Avatars/GrineerMarinePistolAvatar":
							case "/Lotus/Types/Enemies/GrineerChampions/Events/WFGrineerChampionBeastmasterAvatar":
								assert(codexScansRequired == 5, path)
								break

							case "/Lotus/Types/Enemies/Corpus/Spaceman/EliteSpacemanAvatarLeader":
							case "/Lotus/Types/Enemies/Grineer/SeaLab/Avatars/GrineerMarinePistolAvatarLeader":
								assert(codexScansRequired == 3, path)
								break
						end

						ExportEnemies.avatars.__order:insert(path)
						ExportEnemies.avatars[path] = {
							__order = { "name", "icon", "description", "faction", "health", "damageController", "factionResistanceKeyword", "killXPReward", "droptable", "codexSecret", --[["excludeFromCodex",]] "codexScansRequired", "excludeFromSimulacrum" },
							name = LocTag,
							icon = obj_find_property(path, "Icon"),
							description = obj_find_property(path, "ShortDesc"),
							faction = Faction,
							health = obj_find_property(path, "MaxHealth") or 100,
							damageController = DamageControllerType,
							factionResistanceKeyword = obj_find_property(path, "FactionResistanceKeyword"),
							killXPReward = killXPReward or 0,
							droptable = DropTable,
							codexSecret = (obj_find_property(path, "CodexSecret") == 1 ? true : nil),
							--excludeFromCodex = (obj_find_property(path, "ExcludeFromCodex") ~= 0 ? true : nil), -- no avatar seems to have this
							codexScansRequired = codexScansRequired,
							excludeFromSimulacrum = (obj_find_property(path, "ExcludedFromSimulacrum") == 1 ? true : nil),
						}
						import_from_languages_bin(LocTag)
						if ExportEnemies.avatars[path].description == "" then
							ExportEnemies.avatars[path].description = nil
						end
						if ExportEnemies.avatars[path].icon == "" then
							ExportEnemies.avatars[path].icon = nil
						end
						if languages_bin_dicts.en[ExportEnemies.avatars[path].description] then
							import_from_languages_bin(ExportEnemies.avatars[path].description)
						end

						if not ExportEnemies.damageControllers[DamageControllerType] then
							ExportEnemies.damageControllers.__order:insert(DamageControllerType)
							ExportEnemies.damageControllers[DamageControllerType] = {
								__order = { "armor", "shield", "hitProxies", "unhandledProcTypes" },
								--health_resistance = obj_find_property(DamageControllerType, "HealthResistanceKeyword") or "RK_FLESH",
								armor = obj_find_property(DamageControllerType, "ArmourRating") or 0,
								--armor_resistance = obj_find_property(DamageControllerType, "ArmourResistanceKeyword") or "RK_ARMOR",
								shield = obj_find_property(DamageControllerType, "MaxShield") or 100,
								--shield_resistance = obj_find_property(DamageControllerType, "ShieldResistanceKeyword") or "RK_SHIELD",
								unhandledProcTypes = unhandledProcTypes,
							}
							local HitProxies, HitProxies_path_base = obj_find_property(DamageControllerType, "HitProxies")
							if HitProxies then
								local hitProxies = {}
								for HitProxies as HitProxy do
									local hitProxyType = obj_resolve_path(HitProxies_path_base, HitProxy.Type)
									hitProxies:insert({
										__order = { "bone", "type" },
										bone = HitProxy.BoneName,
										type = hitProxyType
									})
									if not ExportEnemies.hitProxies[hitProxyType] then
										local hitProxy = {
											__order = { "damageAtten", "criticalChance", "criticalMultiplier" },
											damageAtten = obj_find_property(hitProxyType, "DamageAtten"),
											criticalChance = obj_find_property(hitProxyType, "CriticalChance"),
											criticalMultiplier = obj_find_property(hitProxyType, "CriticalMultiplier"),
										}
										if hitProxy:size() ~= 1 then
											ExportEnemies.hitProxies.__order:insert(hitProxyType)
											ExportEnemies.hitProxies[hitProxyType] = hitProxy
										end
									end
								end
								if #hitProxies ~= 0 then
									ExportEnemies.damageControllers[DamageControllerType].hitProxies = hitProxies
								end
							end
						end

						if path == "/Lotus/Types/Enemies/Grineer/GrineerAvatars/GrineerMarineAvatar"
							or path == "/Lotus/Types/Enemies/Grineer/GrineerAvatars/GrineerMarineShieldAvatar"
							or path == "/Lotus/Types/Enemies/Grineer/GrineerAvatars/TutoralMarinerAvatar"
							or path == "/Lotus/Types/Enemies/Grineer/GrineerAvatars/TutoralMarinerIntroAvatar"
						then
							ExportEnemies.avatars[path].__order:insert("isFrivolous")
							ExportEnemies.avatars[path].isFrivolous = true
						end
					end
				end
			end
		end
	end
	for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/Enemies", true) as file do
		if io.isfile(file) then
			local path = file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
			local obj = obj_from_path(path)
			if obj.data?.AvatarTypes then
				if obj_has_parent(path, "/EE/Types/Npc/NpcAgent") then
					local avatarTypes = {
						__order = { "STANDARD", "EXIMUS", "RARE" },
						STANDARD = obj_resolve_path(path, obj_find_property_2(path, "AvatarTypes", "STANDARD") or ""),
						EXIMUS = obj_resolve_path(path, obj_find_property_2(path, "AvatarTypes", "EXIMUS") or ""),
						RARE = obj_resolve_path(path, obj_find_property_2(path, "AvatarTypes", "RARE") or ""),
					}
					if avatarTypes.STANDARD then
						process_enemy_avatar(avatarTypes.STANDARD)
					end
					if avatarTypes.EXIMUS then
						process_enemy_avatar(avatarTypes.EXIMUS)
					end
					if avatarTypes.RARE then
						process_enemy_avatar(avatarTypes.RARE)
					end
					if ExportEnemies.avatars[avatarTypes.STANDARD] or ExportEnemies.avatars[avatarTypes.EXIMUS] or ExportEnemies.avatars[avatarTypes.RARE] then
						ExportEnemies.agents.__order:insert(path)
						ExportEnemies.agents[path] = {
							__order = { "baseLevel", "avatarTypes" },
							baseLevel = obj.data.BaseLevel or 1,
							avatarTypes = avatarTypes,
						}
						if NewAdditionalInventory := obj_find_property(path, "NewAdditionalInventory") then
							local items = {}
							for NewAdditionalInventory as item do
								if itemType := obj_resolve_path(path, item.item) then
									items:insert({
										--__order = { "type" },
										type = itemType,
									})
									if not obj_has_parent(itemType, "/Lotus/Types/Game/PowerSuit") and not ExportEnemies.aiWeapons[itemType] then
										local weapon = {
											__order = { "name", "description", "icon" },
											name = obj_find_property(itemType, "LocalizeTag"),
											description = obj_find_property(itemType, "LocalizeDescTag"),
											icon = obj_find_property(itemType, "Icon"),
										}
										if weapon.name == "" then
											weapon.name = nil
										elseif languages_bin_dicts.en[weapon.name] then
											import_from_languages_bin(weapon.name)
										end
										if weapon.description == "" then
											weapon.description = nil
										elseif languages_bin_dicts.en[weapon.description] then
											import_from_languages_bin(weapon.description)
										end
										if weapon.icon == "" then
											weapon.icon = nil
										end
										add_weapon_behaviours(weapon, itemType)
										ExportEnemies.aiWeapons.__order:insert(itemType)
										ExportEnemies.aiWeapons[itemType] = weapon
									end
								end
							end
							if #items ~= 0 then
								ExportEnemies.agents[path].__order:insert("items")
								ExportEnemies.agents[path].items = items
							end
						end
					end
				end
			end
		end
	end

	for droptable, name in {
		["/Lotus/Types/DropTables/EidolonDropTables/TeralystKilledDropTable"] = "eidolon teralyst (duplicate)",
		["/Lotus/Types/DropTables/EidolonDropTables/TeralystCapturedDropTable"] = "eidolon teralyst (special)",
		["/Lotus/Types/DropTables/EidolonDropTables/TeralystBigKilledDropTable"] = "eidolon gantulyst (duplicate)",
		["/Lotus/Types/DropTables/EidolonDropTables/TeralystBigCapturedDropTable"] = "eidolon gantulyst (special)",
		["/Lotus/Types/DropTables/EidolonDropTables/TeralystRainKilledDropTable"] = "eidolon hydrolyst (duplicate)",
		["/Lotus/Types/DropTables/EidolonDropTables/TeralystRainCapturedDropTable"] = "eidolon hydrolyst (special)",
		["/Lotus/Types/DropTables/AscensionWrinkleNormalDropTable"] = "sister of parvos (ascension mode)",
		["/Lotus/Types/DropTables/AscensionWrinkleHardDropTable"] = "sister of parvos (ascension hard mode)",
		["/Lotus/Types/DropTables/ContainerDropTables/VoidVaultMissionRewardsDropTable"] = "entrati netracell coffer",
		["/Lotus/Types/DropTables/Tau/TwelveMinuteWar/TMWPrimeMinibossSteelPathDropTable"] = "commandeered ash prime",
	} do
		ExportEnemies.droptables.__order:insert(droptable)
		ExportEnemies.droptables[droptable] = drops_by_enemy_name[name]
	end

	ExportEnemies.droptables.__order:insert("/Lotus/Types/DropTables/LawyerDropTable")
	ExportEnemies.droptables["/Lotus/Types/DropTables/LawyerDropTable"] = {
		{
			__order = { "type", "chance", "items" },
			type = "blueprint",
			chance = 1.0,
			items = {
				{
					__order = { "type", "probability" },
					type = "/Lotus/Types/Recipes/ZanukaPetParts/ZanukaPetPartHeadABlueprint",
					probability = 0.3333
				},
				{
					__order = { "type", "probability" },
					type = "/Lotus/Types/Recipes/ZanukaPetParts/ZanukaPetPartHeadBBlueprint",
					probability = 0.3333
				},
				{
					__order = { "type", "probability" },
					type = "/Lotus/Types/Recipes/ZanukaPetParts/ZanukaPetPartHeadCBlueprint",
					probability = 0.3333
				}
			}
		}
	}

	ExportEnemies.agents.__order:sort()
	ExportEnemies.avatars.__order:sort()
	ExportEnemies.damageControllers.__order:sort()
	ExportEnemies.droptables.__order:sort()
	ExportEnemies.hitProxies.__order:sort()
	ExportEnemies.aiWeapons.__order:sort()
	write_data_file("ExportEnemies.json", ExportEnemies)
end

$if false then
	print "Creating ExportIntrinsics..."
	do
		local ExportIntrinsics = {
			__order = {}
		}
		local intrinsics = {
			{ "LPS_TACTICAL", "/Lotus/Language/Intrinsics/RailjackIntrinsicTactic", "/Lotus/Interface/Icons/Intrinsics/IntrinsicsTacticianIcon.png" },
			{ "LPS_PILOTING", "/Lotus/Language/Intrinsics/RailjackIntrinsicPilot", "/Lotus/Interface/Icons/Intrinsics/IntrinsicsPilotingIcon.png" },
			{ "LPS_GUNNERY", "/Lotus/Language/Intrinsics/RailjackIntrinsicGunner", "/Lotus/Interface/Icons/Intrinsics/IntrinsicsGunneryIcon.png" },
			{ "LPS_ENGINEERING", "/Lotus/Language/Intrinsics/RailjackIntrinsicEngineer", "/Lotus/Interface/Icons/Intrinsics/IntrinsicsEngineeringIcon.png" },
			{ "LPS_COMMAND", "/Lotus/Language/Intrinsics/RailjackIntrinsicCommand", "/Lotus/Interface/Icons/Intrinsics/IntrinsicsCommandIcon.png" },
		}
		for intrinsics as intrinsic do
			ExportIntrinsics.__order:insert(intrinsic[1])
			local exported = {
				__order = { "name", "description", "icon", "ranks" },
				name = intrinsic[2],
				description = intrinsic[2].."Desc",
				icon = intrinsic[3],
				ranks = {},
			}
			import_from_languages_bin(exported.name)
			import_from_languages_bin(exported.description)
			for i = 1, 10 do
				local rank = {
					__order = { "name", "description" },
					name = intrinsic[2].."_"..i,
					description = intrinsic[2].."Desc_"..i,
				}
				import_from_languages_bin(rank.name)
				import_from_languages_bin(rank.description)
				exported.ranks:insert(rank)
			end
			ExportIntrinsics[intrinsic[1]] = exported
		end
		write_data_file("ExportIntrinsics.json", ExportIntrinsics)
	end
$end

print "Creating ExportSyndicates..."
do
	local ExportSyndicates = { __order = {} }
	-- Note: These are also listed in LotusGameConfig
	for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Syndicates", true) as file do
		if io.isfile(file) then
			local path = file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
			local obj = obj_from_path(path)
			if obj.parent == "/Lotus/Types/Game/Syndicate" then
				local tag = path:sub(path:rfind("/") + 1)
				local SyndicateDesc = obj.data.SecretSyndicateDesc or obj.data.SyndicateDesc
				if SyndicateDesc ~= "/Lotus/Language/Syndicates/RadioLegionDesc" then
					import_from_languages_bin(SyndicateDesc)
				else
					SyndicateDesc = nil
				end
				ExportSyndicates.__order:insert(tag)
				--[[if obj.data.InitiationSacrifice and obj.data.InitiationSacrifice.credits == 0 and #obj.data.InitiationSacrifice.items == 0 then
					obj.data.InitiationSacrifice = nil
				end]]
				ExportSyndicates[tag] = {
					__order = { "uniqueName", "name", "icon", "description", "colour", "backgroundColour", "dailyLimitBin", "initiationSacrifice", "initiationReward", "dailyChallenges", "weeklyChallenges" },
					uniqueName = path,
					name = obj.data.SecretSyndicateName or obj.data.SyndicateName,
					icon = obj.data.IconTexture,
					description = SyndicateDesc,
					colour = format_colour_arr(obj.data.LogoColor),
					backgroundColour = format_colour_arr(obj.data.BackgroundColor),
					dailyLimitBin = obj.data.DailyLimitBin or "STANDING_LIMIT_BIN_NORMAL",
					initiationSacrifice = obj.data.InitiationSacrifice,
					initiationReward = obj.data.InitiationReward,
					dailyChallenges = tag ~= "KahlSyndicate" ? obj.data.SeasonChallenges?[1]?.dailyChallenges : nil,
					weeklyChallenges = tag ~= "KahlSyndicate" ? obj.data.SeasonChallenges?[1]?.weeklyChallenges : nil,
				}
				import_from_languages_bin(ExportSyndicates[tag].name)
				if obj.data.Alignments then
					ExportSyndicates[tag].__order:insert("alignments")
					ExportSyndicates[tag].alignments = { __order = {} }
					for obj.data.Alignments as entry do
						ExportSyndicates[tag].alignments.__order:insert(entry.Syndicate)
						ExportSyndicates[tag].alignments[entry.Syndicate] = entry.Multiplier
					end
				end
				if obj.data.Titles then
					ExportSyndicates[tag].__order:insert("titles")
					ExportSyndicates[tag].titles = {}
					for obj.data.Titles as title do
						if title.icon == "" then title.icon = nil end
						if title.consequenceLoc == "" then title.consequenceLoc = nil end
						if title.requiresSacrifice == 1 and (title.sacrifice.credits ~= 0 or #title.sacrifice.items ~= 0) then
							assert(title.sacrifice.desc == "", path)
							title.sacrifice.desc = nil
						else
							title.sacrifice = nil
						end
						ExportSyndicates[tag].titles:insert({
							__order = { "level", "name", "icon", "description", "minStanding", "maxStanding", "sacrifice", "reward", "storeItemReward" },
							level = title.level or error(),
							name = title.titleLoc or error(),
							icon = title.icon,
							description = title.consequenceLoc,
							minStanding = title.minXP or error(),
							maxStanding = title.maxXP or error(),
							sacrifice = title.sacrifice,
							reward = title.rewards and #title.rewards ~= 0 ? title.rewards[1] : nil,
							storeItemReward = title.storeItemReward and title.storeItemReward ~= "" ? title.storeItemReward : nil
						})
						import_from_languages_bin(title.titleLoc)
						if title.consequenceLoc then
							import_from_languages_bin(title.consequenceLoc)
						end
					end
				end
				if obj.data.StandingBonuses then
					ExportSyndicates[tag].__order:insert("medallions")
					ExportSyndicates[tag].medallions = {}
					for obj.data.StandingBonuses as medallion do
						ExportSyndicates[tag].medallions:insert({
							__order = { "itemType", "standing" },
							itemType = medallion.ItemType,
							standing = medallion.Standing,
						})
					end
					ExportSyndicates[tag].__order:insert("medallionsCappedByDailyLimit")
					ExportSyndicates[tag].medallionsCappedByDailyLimit = (obj.data.StandingBonusesCappedByDailyLimit == 1)
				end
				ExportSyndicates[tag].__order:insert("favours")
				ExportSyndicates[tag].favours = {}
				if path ~= "/Lotus/Syndicates/Kahl/KahlSyndicate" then
					assert(obj.data.Manifest, path)
					local manifest = io.contents("extras/datafiles/Extracted/Debug"..obj_resolve_path(path, obj.data.Manifest)..".json") |> json.decode
					if manifest.Favors then
						for manifest.Favors as favor do
							ExportSyndicates[tag].favours:insert({
								__order = { "storeItem", "standingCost", "creditsCost", "requiredLevel", "rankUpReward" },
								storeItem = favor.storeItem,
								standingCost = favor.standingCost,
								creditsCost = favor.creditsCost,
								requiredLevel = favor.requiredLevel,
								rankUpReward = (favor.availableAsFreeFavor == 1),
							})
						end
					end
				end
			end
		end
	end
	--ExportSyndicates.__order:sort()
	write_data_file("ExportSyndicates.json", ExportSyndicates)
end

print "Creating ExportTextIcons..."
do
	local ExportTextIcons = { __order = {} }
	for obj_from_path("/Lotus/Types/Interface/LotusPlatformIconCollection").data.Icons as icon do
		if not icon.Name or icon.Name == "" then
			continue
		end
		ExportTextIcons.__order:insert(icon.Name)
		ExportTextIcons[icon.Name] = {
			__order = {}
		}
		for icon.Platforms as platformIcon do
			if platformIcon.Material ~= "" then
				if path := obj_from_path(platformIcon.Material).data?["TX:DiffuseMap"] then
					ExportTextIcons[icon.Name].__order:insert(platformIcon.IconPlatform)
					ExportTextIcons[icon.Name][platformIcon.IconPlatform] = obj_resolve_path(platformIcon.Material, path)
				else
					for line in io.lines("extras/materials/Extracted" .. platformIcon.Material .. ".txt") do
						if line:startswith("TX:DiffuseMap = ") and line:endswith(".png") then
							ExportTextIcons[icon.Name].__order:insert(platformIcon.IconPlatform)
							local path = line:sub(17)
							if path[1] ~= "/" then
								path = path_get_parent(platformIcon.Material) .. "/" .. path
							end
							ExportTextIcons[icon.Name][platformIcon.IconPlatform] = path
							if not ExportTextIcons[icon.Name][platformIcon.IconPlatform] then
								print("Could not resolve icon for "..platformIcon.Material)
							end
							break
						end
					end
				end
			end
		end
	end
	write_data_file("ExportTextIcons.json", ExportTextIcons)
end

do
	local ExportTilesets = { __order = {} }
	for io.listdir(PACKAGES_BIN_BASE .. "/Lotus/Types/Game/RegionTilesets", true) as file do
		if io.isfile(file) then
			local path = file:sub(#PACKAGES_BIN_BASE + 1, -6):replace("\\", "/")
			local obj = obj_from_path(path)
			if obj.data.MissionPermutations then
				local name = path:sub(34)
				ExportTilesets.__order:insert(name)
				ExportTilesets[name] = {
					__order = { "uniqueName", "faction", "missions" },
					uniqueName = path,
					faction = obj.data.Faction ?? (name == "VenusLandscapeTileset" ? "FC_CORPUS" : "FC_GRINEER"),
					missions = obj.data.MissionPermutations:filter(|x| -> x.procLevel ~= ""),
				}
			end
		end
	end
	ExportTilesets.__order:sort()
	write_data_file("ExportTilesets.json", ExportTilesets)
end

local function Range(minValue, maxValue)
	return {
		__order = { "minValue", "maxValue" },
		minValue = minValue,
		maxValue = maxValue,
	}
end

do
	local ExportVendors = { __order = {} }
	for io.listdir("extras/datafiles/Extracted/Debug/Lotus/Types/Game/VendorManifests", true) as file do
		if io.isfile(file) then
			local path = file:sub(33, -6):replace("\\", "/")
			local obj = io.contents(file) |> json.decode|json.withorder|
			if obj.ItemManifest then
				local items = {}
				for obj.ItemManifest as rawItem do
					local item = {
						__order = { "storeItem", "quantity", "alwaysOffered", "bin", "probability", "rotatedWeekly", "duplicates" },
						storeItem = rawItem.StoreItem,
						quantity = rawItem.QuantityMultiplier,
						alwaysOffered = (rawItem.AlwaysOffered == 1),
						bin = tonumber(rawItem.Bin:sub(5)),
						probability = rawItem.AlwaysOffered == 1 ? nil : rawItem.AppearanceFrequency,
						rotatedWeekly = (rawItem.AlwaysOffered ~= 1 and rawItem.RotatedWeekly == 1) ? true : nil,
						duplicates = rawItem.NumDuplicatesToAdd,
					}
					if rawItem.RegularPrice[1] ~= 0 then
						item.__order:insert("credits")
						if rawItem.RegularPrice[1] == rawItem.RegularPrice[2] then
							item.credits = rawItem.RegularPrice[1]
						else
							item.credits = {
								__order = { "minValue", "maxValue", "step" },
								minValue = rawItem.RegularPrice[1],
								maxValue = rawItem.RegularPrice[2],
								step = rawItem.RegularPriceStep
							}
						end
					end
					if rawItem.PremiumPrice[1] ~= 0 then
						item.__order:insert("platinum")
						if rawItem.PremiumPrice[1] == rawItem.PremiumPrice[2] then
							item.platinum = rawItem.PremiumPrice[1]
						else
							item.platinum = {
								__order = { "minValue", "maxValue" },
								minValue = rawItem.PremiumPrice[1],
								maxValue = rawItem.PremiumPrice[2]
							}
						end
					end
					if #rawItem.ItemPrices ~= 0 then
						item.__order:insert("itemPrices")
						item.itemPrices = rawItem.ItemPrices
					end
					if rawItem.NumRandomCurrencies ~= 0 then
						item.__order:insert("numRandomItemPrices")
						item.numRandomItemPrices = rawItem.NumRandomCurrencies
					end
					if not item.alwaysOffered and not item.rotatedWeekly and rawItem.DurationAvailable then
						item.__order:insert("durationHours")
						if rawItem.DurationAvailable[1] == rawItem.DurationAvailable[2] then
							item.durationHours = rawItem.DurationAvailable[1]
						else
							item.durationHours = Range(rawItem.DurationAvailable[1], rawItem.DurationAvailable[2])
						end
					end
					if rawItem.PurchaseQuantityLimit ~= 0 or not rawItem.AllowMultipurchase then
						item.__order:insert("purchaseLimit")
						item.purchaseLimit = rawItem.PurchaseQuantityLimit or 1
						assert(rawItem.AllowMultipurchase or item.purchaseLimit == 1)
					end
					if rawItem.Affiliation ~= "" and (rawItem.MinAffiliationRank ~= 0 or rawItem.ReductionPerPositiveRank ~= 0 or rawItem.IncreasePerNegativeRank ~= 0) then
						item.__order:insert("syndicate")
						item.syndicate = {
							__order = { "tag", "minRank", "standingCost", "reductionPerPositiveRank", "increasePerNegativeRank" },
							tag = rawItem.Affiliation:split("/"):back(),
							minRank = rawItem.MinAffiliationRank,
							standingCost = rawItem.StandingCost,
							reductionPerPositiveRank = rawItem.ReductionPerPositiveRank,
							increasePerNegativeRank = rawItem.IncreasePerNegativeRank,
						}
					end
					if rawItem.FocusXpCost.Polarity ~= "AP_UNIVERSAL" and rawItem.FocusXpCost.Cost ~= 0 then
						item.__order:insert("focusXpCost")
						item.focusXpCost = {
							__order = { "polarity", "cost" },
							polarity = rawItem.FocusXpCost.Polarity,
							cost = rawItem.FocusXpCost.Cost,
						}
					end
					items:insert(item)
				end
				if #items ~= 0 then
					ExportVendors.__order:insert(path)
					ExportVendors[path] = {
						__order = { "isDynamic", "isOneBinPerCycle", "requiredGoalTag", "items" },
						isDynamic = obj.IsDynamic == 1,
						isOneBinPerCycle = obj.IsDynamic == 1 ? (obj.ScheduleOneBinPerCycle == 1) : nil,
						requiredGoalTag = obj.RequiredGoalTag,
						items = items,
					}
					if obj.ScheduleOneBinPerCycle == 1 then
						assert(obj.IsDynamic == 1)
					end
					if obj.RandomCurrencies then
						local last_bin = 0
						local randomCurrenciesPerBin = {}
						for obj.RandomCurrencies.__order as bin do
							while last_bin ~= tonumber(bin:sub(5)) do
								randomCurrenciesPerBin:insert({})
								++last_bin
							end
							assert(last_bin == tonumber(bin:sub(5)), path)
							++last_bin
							local processedArr = {}
							for obj.RandomCurrencies[bin] as randomCurrency do
								processedArr:insert({
									__order = { "type", "count" },
									type = randomCurrency.ItemType,
									count = Range(randomCurrency.ValueRange[1], randomCurrency.ValueRange[2]),
								})
							end
							randomCurrenciesPerBin:insert(processedArr)
						end
						ExportVendors[path].__order:insert("randomItemPricesPerBin")
						ExportVendors[path].randomItemPricesPerBin = randomCurrenciesPerBin
					end
					if obj.NumItemsAvailable then
						ExportVendors[path].__order:insert("numItems")
						ExportVendors[path].numItems = Range(obj.NumItemsAvailable[1], obj.NumItemsAvailable[2])
					end
					if obj.NumItemsPerBin then
						local last_bin = 0
						local numItemsPerBin = {}
						for obj.NumItemsPerBin.__order as bin do
							assert(last_bin == tonumber(bin:sub(5)), path)
							++last_bin
							numItemsPerBin:insert(obj.NumItemsPerBin[bin])
						end
						ExportVendors[path].__order:insert("numItemsPerBin")
						ExportVendors[path].numItemsPerBin = numItemsPerBin
					end
					if obj.RandomSeedType then
						ExportVendors[path].__order:insert("randomSeedType")
						ExportVendors[path].randomSeedType = obj.RandomSeedType
					end
				else
					print("skipping "..path)
				end
			end
		end
	end
	ExportVendors.__order:sort()
	write_data_file("ExportVendors.json", ExportVendors)
end

print "Creating ExportVirtuals..."
do
	local ExportVirtuals = { __order = {} }
	local add_virtual
	function add_virtual(path)
		local obj = obj_from_path(path)
		if obj.parent then
			ExportVirtuals.__order:insert(path)
			local parentPath = obj_resolve_path(path, obj.parent)
			local data = {
				__order = { "parentName" },
				parentName = parentPath,
			}
			if obj.data?.LocalizeTag then
				if languages_bin_dicts.en[obj.data.LocalizeTag] then
					data.__order:insert("name")
					data.name = obj.data.LocalizeTag
					import_from_languages_bin(obj.data.LocalizeTag)
				end
			end
			ExportVirtuals[path] = data
			if virtuals_tracker[parentPath] == nil and ExportVirtuals[parentPath] == nil then
				add_virtual(parentPath)
			end
		end
	end
	for path, value in virtuals_tracker do
		if value then
			add_virtual(path)
		end
	end
	ExportVirtuals.__order:sort()
	write_data_file("ExportVirtuals.json", ExportVirtuals)
end

print "Transposing ExportManifest into ExportImages..."
do
	local ExportManifest = io.contents(PE_BASE .. "/ExportManifest.json") |> json.decode|json.withorder|
	local forum_glyphs = io.contents("extras/forum-glyphs-ok.cat.txt") |> cat.decode|"flat"|
	local map = { __order = {} }
	for ExportManifest.Manifest as item do
		local [ path, hash ] = item.textureLocation:split("!")
		if not map[path] then
			map.__order:insert(path)
			map[path] = { __order = {} }
			if path ~= "/Lotus/Interface/Icons/Player/ContentCreators/DeathMa666ot.png" then -- https://forums.warframe.com/topic/1428336-deathma666ot-glyph-is-not-on-contentwarframecompublicexport/
				map[path].__order:insert("contentHash")
				map[path].contentHash = hash
			end
			if forum_glyphs[path] then
				map[path].__order:insert("forumName")
				map[path].forumName = forum_glyphs[path]:sub(53, -5)
			end
		end
	end
	map.__order:sort()
	write_data_file("ExportImages.json", map)
end

print "Creating ExportCodex..."
do
	local ExportCodex = io.contents("extras/ExportCodex.json") |> json.decode|json.withorder|
	ExportCodex.__order = { "objects", "loreFragments", "songs", "fighterFrames" }
	for path, object in ExportCodex.objects do
		if path ~= "__order" then
			import_from_languages_bin(object.name)

			if LongDesc := obj_find_property(path, "LongDesc") then
				object.__order:insert(2, "description")
				object.description = LongDesc
				import_from_languages_bin(LongDesc)
			end
		end
	end
	ExportCodex.loreFragments = { __order = {} }
	for ExportCodex.allTypes as uniqueName do
		if uniqueName:startswith("/Lotus/Types/Lore/Fragments/") then
			local name = obj_find_property(uniqueName, "Name")
			import_from_languages_bin(name)
			local description = obj_find_property(uniqueName, "Description")
			if description then
				import_from_languages_bin(description)
			end
			ExportCodex.loreFragments.__order:insert(uniqueName)
			ExportCodex.loreFragments[uniqueName] = {
				__order = { "name", "description", "image", "reqScans" },
				name = name,
				description = description,
				image = obj_find_property(uniqueName, "Image"),
				reqScans = obj_find_property(uniqueName, "ScansNeeded") or 5,
			}
			if secretTransmission := obj_find_property(uniqueName, "SecretTransmission") then
				local stdata = obj_from_path(secretTransmission).data
				ExportCodex.loreFragments[uniqueName].__order:insert("secretTransmission")
				local text = obj_resolve_path(secretTransmission, stdata.Text)
				import_from_languages_bin(text)
				ExportCodex.loreFragments[uniqueName].secretTransmission = {
					__order = { "sound", "text" },
					sound = obj_resolve_path(secretTransmission, stdata.Sound),
					text = text,
				}
			end
		end
	end
	local InventoryController = obj_from_path("/Lotus/Types/Player/InventoryController")
	ExportCodex.songs = { __order = {} }
	for InventoryController.data.SongFragments as uniqueName do
		local name = obj_find_property(uniqueName, "Name")
		import_from_languages_bin(name)
		ExportCodex.songs.__order:insert(uniqueName)
		ExportCodex.songs[uniqueName] = {
			__order = { "name", "song", "reqScans" },
			name = name,
			song = obj_find_property(uniqueName, "Song"),
			reqScans = obj_find_property(uniqueName, "ScansNeeded"),
		}
	end
	ExportCodex.fighterFrames = { __order = {} }
	for InventoryController.data.FrameFighterFragments as uniqueName do
		local name = obj_find_property(uniqueName, "Name")
		import_from_languages_bin(name)
		ExportCodex.fighterFrames.__order:insert(uniqueName)
		ExportCodex.fighterFrames[uniqueName] = {
			__order = { "name", "suit", "reqScans" },
			name = name,
			suit = obj_find_property(uniqueName, "PowerSuitRes"),
			reqScans = obj_find_property(uniqueName, "ScansNeeded"),
		}
	end
	write_data_file("ExportCodex.json", ExportCodex)
end

print "Sorting tags alphabetically..."
tag_order:sort()

for LANGS as lang do
	print $"Writing dict for {lang}..."
	write_string_map_file("dict." .. lang .. ".json", dicts[lang])
end
